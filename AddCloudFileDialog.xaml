<Window x:Class="SideDesk.AddCloudFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="{l:T cloudDrive.addCloudFile}" SizeToContent="Height" MinHeight="200" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <Window.Resources>
        <!-- 页签样式：透明底、选中/悬停高亮，融入主题 -->
        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Padding="16,6" Margin="0,0,4,0"
                                Background="Transparent" CornerRadius="6" Cursor="Hand">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="tabBorder" Property="TextElement.Foreground"
                                        Value="{DynamicResource BrushTextMuted}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background"
                                        Value="{DynamicResource BrushInputBG}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background"
                                        Value="{DynamicResource BrushInputBG}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <emoji:TextBlock Grid.Row="0" Text="{l:T cloudDrive.addCloudFileEmoji}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                         Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,10"/>

        <!-- 顶部页签：两种导入方式 -->
        <TabControl x:Name="modeTabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
                    Padding="0" SelectedIndex="0" Margin="-2,0,0,12">
            <!-- 方式一：来自云盘 -->
            <TabItem>
                <TabItem.Header>
                    <emoji:TextBlock Text="{l:T cloudDrive.fromCloudDrive}" FontSize="{DynamicResource FontSizeNormal}"/>
                </TabItem.Header>
                <StackPanel Margin="2,8,2,2">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="{l:T cloudDrive.cloudDrive}" Width="70" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                        <ComboBox x:Name="cloudSpaceCombo" Height="30"
                                  Style="{StaticResource GlobalComboBoxStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="pickFromDriveBtn" Content="{l:T cloudDrive.chooseFilesFromCloud}" DockPanel.Dock="Right"
                                Style="{StaticResource StandardButtonStyle}" Padding="12,5" Margin="8,0,0,0"
                                Click="PickFromDrive_Click"/>
                        <TextBlock Text="{l:T cloudDrive.browseHint}"
                                   FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource BrushTextMuted}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <!-- 方式二：文件ID（网络文件） -->
            <TabItem>
                <TabItem.Header>
                    <emoji:TextBlock Text="{l:T cloudDrive.fileIdEmoji}" FontSize="{DynamicResource FontSizeNormal}"/>
                </TabItem.Header>
                <StackPanel Margin="2,8,2,2">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="{l:T cloudDrive.fileId}" Width="70" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                        <TextBox x:Name="netFileIdBox" Style="{StaticResource GlobalTextBoxStyle}"
                                 ToolTip="{l:T cloudDrive.networkFileHint}"/>
                    </DockPanel>
                    <TextBlock Text="{l:T cloudDrive.networkFilePasteHint}"
                               FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource BrushTextMuted}"
                               TextWrapping="Wrap" Margin="70,0,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 显示名称（两种方式通用） -->
        <DockPanel Grid.Row="2" Margin="0,0,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{l:T common.nameLabel}" Width="70" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
            <TextBox x:Name="nameBox" Style="{StaticResource GlobalTextBoxStyle}"
                     ToolTip="{l:T cloudDrive.autoNameHint}"/>
        </DockPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:T common.import}" Width="75" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="{l:T common.cancel}" Width="75" Click="CancelButton_Click" IsCancel="True"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
