<Window x:Class="SideDesk.ScreenManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="{l:T 小屏管理}" Width="475"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushDialogBG}"
        Foreground="{DynamicResource BrushTextMain}">
    <StackPanel Margin="20">
        <emoji:TextBlock Text="{l:T 勾选「显示」的小屏才会出现在顶部标签栏；删除小屏将同时移除其下方所有模块。}"
                         FontSize="12"
                         Foreground="{DynamicResource BrushTextSec}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12"/>

        <StackPanel x:Name="listPanel"/>

        <Button Content="{l:T 关闭}" Width="75" MinHeight="30"
                HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource StandardButtonStyle}"
                IsCancel="True" Click="CloseBtn_Click"/>
    </StackPanel>
</Window>
