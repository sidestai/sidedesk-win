<Window x:Class="SideDesk.FileDropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        Title="{l:T nativePanel.dropFilesHere}" Width="420" Height="320"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <DockPanel Margin="20">
        <!-- 标题 -->
        <TextBlock DockPanel.Dock="Top" Text="{l:T nativePanel.dropFilesHere}" FontWeight="Bold"
                   FontSize="{DynamicResource FontSizeSubtitle}"
                   Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,14"/>

        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:T common.close}" Width="75" Click="Close_Click"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>

        <!-- 内容区（目前为空，仅列出拖入的文件） -->
        <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel x:Name="filesPanel"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
