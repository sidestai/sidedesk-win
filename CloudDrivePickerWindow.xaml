<Window x:Class="SideDesk.CloudDrivePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="从云盘选择" Height="500" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBG}"
        Foreground="{DynamicResource BrushTextMain}">
    <Window.Resources>
        <!-- 展开/折叠箭头按钮 -->
        <Style x:Key="treeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="18" Height="18">
                            <Path x:Name="arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 5 3 L 13 9 L 5 15 Z"
                                  Fill="{DynamicResource BrushTextMuted}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 树节点容器：绑定 IsExpanded，悬停高亮 -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="expander" Grid.Row="0" Grid.Column="0"
                                          Style="{StaticResource treeExpanderStyle}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border x:Name="headerBorder" Grid.Row="0" Grid.Column="1"
                                    Padding="4,4" CornerRadius="6" Background="Transparent">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="Stretch"/>
                            </Border>
                            <ItemsPresenter x:Name="itemsHost" Grid.Row="1" Grid.Column="1"
                                            Margin="16,0,0,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="itemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger SourceName="headerBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="headerBorder" Property="Background"
                                        Value="{DynamicResource BrushListViewItemMouseOver}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部提示 -->
        <TextBlock Grid.Row="0" Text="勾选需要导入的文件或目录（可多选），点击箭头展开文件夹"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,10"/>

        <!-- 加载中 -->
        <TextBlock x:Name="loadingText" Grid.Row="1" Text="正在加载..."
                   FontSize="{DynamicResource FontSizeNormal}"
                   Foreground="{DynamicResource BrushTextMuted}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

        <!-- 空目录 -->
        <TextBlock x:Name="emptyText" Grid.Row="1" Text="云盘为空"
                   FontSize="{DynamicResource FontSizeNormal}"
                   Foreground="{DynamicResource BrushTextMuted}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

        <!-- 加载失败 -->
        <TextBlock x:Name="errorText" Grid.Row="1" Text="加载失败，请重试"
                   FontSize="{DynamicResource FontSizeNormal}"
                   Foreground="{DynamicResource BrushTextMuted}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

        <!-- 树形文件浏览（复选框多选） -->
        <TreeView x:Name="treeView" Grid.Row="1"
                  Background="Transparent" BorderThickness="0">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Checked="Selection_Changed" Unchecked="Selection_Changed"/>
                        <emoji:TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <emoji:TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMain}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SizeText}" FontSize="12"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- 底部：已选数量 + 按钮 -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="selectedCountText" Text="已选 0 项" DockPanel.Dock="Left"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource BrushTextMuted}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="okBtn" Content="确定" Width="75" Margin="0,0,10,0"
                        Click="Ok_Click" IsDefault="True" IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="取消" Width="75" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource StandardButtonStyle}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
