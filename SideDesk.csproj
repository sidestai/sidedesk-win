<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 自定义入口 Program.Main：Velopack 要求 VelopackApp.Run() 位于 Main 第一行（覆盖 App.xaml 生成的 Main） -->
    <StartupObject>SideDesk.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>main.ico</ApplicationIcon>
    <!-- Per-Monitor DPI Aware V2（app.manifest）：异 DPI 多屏下 Win32 坐标 API 返回真实物理坐标，
         AppBar 的 ABM_SETPOS 工作区注册依赖此；缺失时副屏坐标虚拟化导致与最大化窗口重叠 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
	<!-- 自动版本号：每次 build 重新生成，无需手动维护 -->
	<!-- 第三段 = 距 2025-01-01 的天数（单调递增且不超 16 位段上限 65535）；第四段 = 构建时刻 HHmm（每次构建唯一） -->
	<_BuildDays>$([System.Math]::Floor($([System.DateTime]::Now.Subtract($([System.DateTime]::Parse("2025-01-01"))).TotalDays)))</_BuildDays>
	<_BuildHHmm>$([System.DateTime]::Now.ToString("HHmm"))</_BuildHHmm>
	<!-- SemVer 三段式（vpk pack 的 packVersion 用此值，粒度到天） -->
	<Version>1.0.$(_BuildDays)</Version>
	<!-- Win32 文件版本（exe 属性、Inno 安装包文件名读此值，粒度到分钟、每次 build 递增） -->
	<FileVersion>1.0.$(_BuildDays).$(_BuildHHmm)</FileVersion>
	<AssemblyVersion>1.0.$(_BuildDays).$(_BuildHHmm)</AssemblyVersion>
	<Deterministic>False</Deterministic>
	<!-- 项目已使用 JSON 做 i18n，排除 NuGet 包卫星资源 DLL（Roslyn 等包的本地化消息） -->
	<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- API 域名区域开关：构建时传 -p:ApiRegion=zh 或 -p:ApiRegion=en 选择后端域名；不传默认 zh（见 Constants.cs） -->
  <PropertyGroup>
    <ApiRegion Condition="'$(ApiRegion)' == ''">zh</ApiRegion>
  </PropertyGroup>
  <Choose>
    <When Condition="'$(ApiRegion)' == 'zh'">
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);API_REGION_ZH</DefineConstants>
      </PropertyGroup>
    </When>
    <When Condition="'$(ApiRegion)' == 'en'">
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);API_REGION_EN</DefineConstants>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);API_REGION_ZH</DefineConstants>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- 排除插件目录，插件为独立项目 -->
    <Compile Remove="plugins\**" />
    <EmbeddedResource Remove="plugins\**" />
    <None Remove="plugins\**" />
    <Page Remove="plugins\**" />
    <!-- 排除打包暂存目录（含市场插件样例，不属于主工程） -->
    <Compile Remove="_PACK\**" />
    <EmbeddedResource Remove="_PACK\**" />
    <None Remove="_PACK\**" />
    <Page Remove="_PACK\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ChromeProtocol.Domains" Version="2.1.1" />
    <PackageReference Include="ChromeProtocol.Runtime" Version="2.1.1" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
    <PackageReference Include="MinimalMcp" Version="0.1.0-alpha" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <PackageReference Include="QRCoder" Version="1.6.*" />
    <PackageReference Include="gong-wpf-dragdrop" Version="3.*" />
    <PackageReference Include="Slions.VirtualDesktop" Version="6.9.2" />
    <PackageReference Include="System.Drawing.Common" Version="9.*" />
    <PackageReference Include="System.Management" Version="9.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.*" />
    <PackageReference Include="System.Speech" Version="9.*" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources\themes\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="langs\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="data-templates\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- WinRT 投影瘦身（build/publish 输出各省约 24.2MB）。
       背景：TFM 带 -windows10.0.19041 时，SDK 会把 targeting pack Microsoft.Windows.SDK.NET.Ref
       的 C#/WinRT 投影 Microsoft.Windows.SDK.NET.dll(23.7MB) + WinRT.Runtime.dll(0.5MB) 复制进输出。
       本工程实测零 WinRT 依赖，三重证据：
         ① 代码中无任何 Windows.* WinRT 命名空间调用（grep 0 命中）；
         ② SideDesk.dll 无这两个程序集的 assemblyref；
         ③ 唯一把 TFM 绑到 19041 的 Slions.VirtualDesktop，其 VirtualDesktop.dll 只有编译器
            自动附加的空 assemblyref，无任何 WinRT typeref（ComWrappers/Marshaler/
            ObjectReference/Projections 全部 0 命中），运行时不会解析加载。
       为何用物理删除：这两个文件以 runtimepack 资产形式从 restore 后的 project.assets.json
       直接进复制列表，实测在 ResolveFrameworkReferences 前摘 FrameworkReference、以及 Remove
       ReferenceCopyLocalPaths/RuntimeCopyLocalItems/ResolvedFileToPublish 均无效，故在复制完成后删。
       deps.json 会残留 runtimepack.Microsoft.Windows.SDK.NET.Ref 的 runtime 条目，属**懒解析**：
       runtimeconfig.json 的 frameworks 只有 Microsoft.NETCore.App + Microsoft.WindowsDesktop.App，
       host 启动不校验 runtimepack，只有真正加载该程序集时才会去找文件——而本工程永不加载。
       注意：TFM 的平台版本不能去掉，否则引用 Slions.VirtualDesktop 会 NU1202 还原失败。 -->
  <Target Name="StripWinRTProjection" AfterTargets="CopyFilesToOutputDirectory;Publish">
    <ItemGroup>
      <_WinRTProjectionFile Include="$(TargetDir)Microsoft.Windows.SDK.NET.dll;$(TargetDir)WinRT.Runtime.dll"
                            Condition="'$(TargetDir)' != ''" />
      <_WinRTProjectionFile Include="$(PublishDir)Microsoft.Windows.SDK.NET.dll;$(PublishDir)WinRT.Runtime.dll"
                            Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Message Importance="high"
             Text="[WinRT瘦身] 剔除投影文件: @(_WinRTProjectionFile->'%(Filename)%(Extension)', ', ')" />
    <Delete Files="@(_WinRTProjectionFile)" />
  </Target>

</Project>
