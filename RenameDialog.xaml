<Window x:Class="SideDesk.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改名称" Height="150" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Text="名称：" Width="50" VerticalAlignment="Center"/>
            <TextBox x:Name="nameBox" Style="{StaticResource GlobalTextBoxStyle}"/>
        </DockPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="70" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="取消" Width="70" Click="Cancel_Click" IsCancel="True"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
