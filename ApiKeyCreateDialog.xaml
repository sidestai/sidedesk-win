<Window x:Class="SideDesk.ApiKeyCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        Title="{l:T 添加密钥}" Height="200" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{l:T 名称：}" Width="50" VerticalAlignment="Center"/>
            <TextBox x:Name="nameBox" Style="{StaticResource GlobalTextBoxStyle}"/>
        </DockPanel>

        <DockPanel Grid.Row="1">
            <TextBlock Text="{l:T 归属：}" Width="50" VerticalAlignment="Center"/>
            <ComboBox x:Name="scopeCombo" Style="{StaticResource GlobalComboBoxStyle}"
                      VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{l:T 确定}" Width="70" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="{l:T 取消}" Width="70" Click="Cancel_Click" IsCancel="True"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
