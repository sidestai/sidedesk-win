<Window x:Class="SideDesk.TitleLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口标题锁定器" Width="850" Height="550"
        WindowStartupLocation="CenterOwner">
    
    <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题栏 -->
                <RowDefinition Height="*"/>    <!-- 规则列表 -->
                <RowDefinition Height="Auto"/> <!-- 底部按钮 -->
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <TextBlock Grid.Row="0" Text="窗口标题锁定器" Foreground="{DynamicResource BrushTextMain}" 
                       FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
            
            <!-- 规则列表 -->
            <ListView Grid.Row="1" x:Name="rulesListView" Margin="12"
                      Background="Transparent" BorderThickness="0"
                      ItemContainerStyle="{StaticResource GlobalListBoxItemStyle}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="进程名" DisplayMemberBinding="{Binding ProcessName}" Width="120"/>
                        <GridViewColumn Header="原始标题" DisplayMemberBinding="{Binding OriginalTitle}" Width="200"/>
                        <GridViewColumn Header="匹配模式" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MatchPattern}" Foreground="{DynamicResource BrushTextSec}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="锁定后文字" DisplayMemberBinding="{Binding LockText}" Width="200"/>
                        <GridViewColumn Header="操作" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="编辑" Margin="0,0,5,0" 
                                                Style="{StaticResource StandardButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Click="EditRule_Click"/>
                                        <Button Content="删除" 
                                                Style="{StaticResource StandardButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Click="DeleteRule_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            
            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
                <Button Content="添加规则" Width="100" Height="30" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddRule_Click"/>
            </StackPanel>
        </Grid>
</Window>
