<Window x:Class="SideDesk.Windows.TeamLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        Title="{l:T 团队组件库}" Height="450" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{l:T 团队组件库}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                   Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,6"/>

        <!-- 提示 -->
        <TextBlock Grid.Row="1" Text="{l:T 团队共享的模块，添加后数据与团队互通}" FontSize="11"
                   Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- 团队切换：选择团队后下方刷新为该团队的组件列表 -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{l:T 团队}" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource BrushTextSec}" Margin="0,0,10,0"/>
            <ComboBox x:Name="teamCombo" Style="{StaticResource GlobalComboBoxStyle}" IsEditable="False"/>
        </DockPanel>

        <!-- 列表区域 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="listPanel"/>
        </ScrollViewer>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:T 关闭}" Width="75" Click="Close_Click"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
