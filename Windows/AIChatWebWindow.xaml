<Window x:Class="SideDesk.Windows.AIChatWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="🤖 AI Chat" Height="700" Width="460"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Background="#1E1E2E">
    <!-- 无边框窗口保留原生边缘拖拽调整大小；CaptionHeight=0 由自定义标题栏自行接管拖动 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0,0,0,1"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="#3A3A4A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏：彩色 emoji 标题 + 按住拖动 + 关闭按钮 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <emoji:TextBlock Text="🤖 AI Chat"
                                 FontSize="13" FontWeight="SemiBold"
                                 Foreground="#E6E6F0"
                                 VerticalAlignment="Center"
                                 Margin="12,8,0,8"/>
                <Button x:Name="closeBtn" Width="26" Height="26" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0" Cursor="Hand" ToolTip="关闭"
                        Style="{DynamicResource GhostButtonStyle}"
                        Click="CloseBtn_Click">
                    <!-- 矢量 Path 画 ✕，不依赖字体字形渲染 -->
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#E6E6F0" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="8" Height="8"/>
                </Button>
            </Grid>

            <wv2:WebView2 x:Name="webView" Grid.Row="1" DefaultBackgroundColor="#1E1E2E"/>
        </Grid>
    </Border>
</Window>
