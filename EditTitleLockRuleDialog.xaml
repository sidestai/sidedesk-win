<Window x:Class="SideDesk.EditTitleLockRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑标题锁定规则" Height="420" Width="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="编辑标题锁定规则" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                   Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,14"/>

        <!-- 内容面板 -->
        <StackPanel Grid.Row="1">
            <!-- 进程名 -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="进程名：" Width="80" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                <TextBox x:Name="processNameBox" Style="{StaticResource GlobalTextBoxStyle}"
                         ToolTip="例如：notepad, chrome, WeChat"/>
            </DockPanel>

            <!-- 原始标题 -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="原始标题：" Width="80" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                <TextBox x:Name="originalTitleBox" Style="{StaticResource GlobalTextBoxStyle}"
                         ToolTip="窗口的原始标题（可选，留空则不限制）"/>
            </DockPanel>

            <!-- 锁定后文字 -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="锁定后文字：" Width="80" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                <TextBox x:Name="lockTextBox" Style="{StaticResource GlobalTextBoxStyle}"
                         ToolTip="替换后的窗口标题文字"/>
            </DockPanel>

            <!-- 匹配模式 -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="匹配模式：" Width="80" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                <ComboBox x:Name="matchModeCombo" Width="200" Style="{StaticResource GlobalComboBoxStyle}">
                    <ComboBoxItem Content="精确匹配 (Equals)"/>
                    <ComboBoxItem Content="包含匹配 (Contains)"/>
                </ComboBox>
            </DockPanel>

            <!-- 匹配字符串 -->
            <DockPanel Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Left" Text="匹配字符串：" Width="80" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                <TextBox x:Name="matchPatternBox" Style="{StaticResource GlobalTextBoxStyle}"
                         ToolTip="用于模糊匹配的字符串（可选）"/>
            </DockPanel>

            <!-- 说明文本 -->
            <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource BrushTextSec}"
                       TextWrapping="Wrap">
                <Run Text="提示："/>
                <LineBreak/>
                <Run Text="• 进程名是必需的，可以通过任务管理器查看"/>
                <LineBreak/>
                <Run Text="• 如果设置了匹配字符串，将优先使用它进行模糊匹配"/>
                <LineBreak/>
                <Run Text="• 原始标题和匹配字符串至少填写一个"/>
            </TextBlock>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="75" Margin="0,0,10,0" Click="OkButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="取消" Width="75" Click="CancelButton_Click"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
