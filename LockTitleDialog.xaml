<Window x:Class="SideDesk.LockTitleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        Title="{l:T nativePanel.lockTitle}" Height="560" Width="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{l:T nativePanel.lockTaskbarTitle}" FontWeight="Bold"
                   FontSize="{DynamicResource FontSizeSubtitle}"
                   Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,12"/>

        <!-- 窗口 / 进程信息 -->
        <TextBlock x:Name="windowInfoText" Grid.Row="1" Foreground="{DynamicResource BrushTextMuted}"
                   FontSize="{DynamicResource FontSizeSmall}" TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,2"/>
        <TextBlock x:Name="processInfoText" Grid.Row="2" Foreground="{DynamicResource BrushTextMuted}"
                   FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,14"/>

        <!-- 锁定后文字 -->
        <TextBlock Grid.Row="3" Text="{l:T nativePanel.lockedTitleTextLabel}" Foreground="{DynamicResource BrushTextSec}"
                   FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6"/>
        <TextBox x:Name="lockTextBox" Grid.Row="4" Style="{StaticResource GlobalTextBoxStyle}"
                 MaxLength="10" Margin="0,0,0,14"/>

        <!-- 匹配字符串 -->
        <TextBlock Grid.Row="5" Text="{l:T nativePanel.matchStringLabel}" Foreground="{DynamicResource BrushTextSec}"
                   FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6"/>
        <StackPanel Grid.Row="6" Margin="0,0,0,12">
            <TextBox x:Name="matchPatternBox" Style="{StaticResource GlobalTextBoxStyle}"
                     ToolTip="{l:T nativePanel.fuzzyMatchHint}"/>
            <TextBlock Text="{l:T nativePanel.exactMatchHint}" Foreground="{DynamicResource BrushTextMuted}"
                       FontSize="{DynamicResource FontSizeTiny}" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <RadioButton x:Name="equalsRadio" Content="{l:T common.exactlyTheSame}" GroupName="matchMode"
                             VerticalAlignment="Center" Margin="0,0,20,0"
                             Foreground="{DynamicResource BrushTextMain}"/>
                <RadioButton x:Name="containsRadio" Content="{l:T common.contains}" GroupName="matchMode"
                             IsChecked="True" VerticalAlignment="Center"
                             Foreground="{DynamicResource BrushTextMain}"/>
            </StackPanel>
        </StackPanel>

        <!-- 窗口 / 进程详细信息 -->
        <TextBlock Grid.Row="7" Text="{l:T window.detailsHeader}" VerticalAlignment="Top"
                   Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"
                   Margin="0,0,0,6"/>
        <Border Grid.Row="7" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="4" Margin="0,24,0,0">
            <TextBox x:Name="detailsBox" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas, Courier New" FontSize="12"
                     BorderThickness="0" Padding="8"
                     Background="{DynamicResource BrushInputBG}"
                     Foreground="{DynamicResource BrushTextMain}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:T common.copyInfo}" Width="90" Margin="0,0,10,0" Click="CopyButton_Click"
                    Style="{StaticResource StandardButtonStyle}"/>
            <Button x:Name="unlockButton" Content="{l:T nativePanel.unlock}" Width="80" Margin="0,0,10,0" Click="UnlockButton_Click"
                    Style="{StaticResource StandardButtonStyle}"/>
            <Button Content="{l:T common.cancel}" Width="80" Margin="0,0,10,0" Click="CancelButton_Click"
                    Style="{StaticResource StandardButtonStyle}"/>
            <Button Content="{l:T common.lock}" Width="80" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
