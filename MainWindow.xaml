<local:AppBarWindow x:Class="SideDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SideDesk"
        xmlns:controls="clr-namespace:SideDesk.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="元桌小屏"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        Background="{DynamicResource BrushBG}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource BrushInputBG}">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="登录" Click="Login_Click"/>
                    <Separator/>
                    <MenuItem Header="切换到 A 屏" Click="SwitchToScreenA"/>
                    <MenuItem Header="切换到 B 屏" Click="SwitchToScreenB"/>
                    <Separator/>
                    <MenuItem Header="居左" Click="Layout_Left"/>
                    <MenuItem Header="居右" Click="Layout_Right"/>
                    <MenuItem Header="双侧" Click="Layout_Both"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="titleText" Text="元桌小屏 [A]" Visibility="Collapsed"/>
                <TextBlock x:Name="singleWindowTitle" Text="元桌小屏" Visibility="Collapsed"
                           VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource BrushTextMain}" FontSize="12"/>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <StackPanel x:Name="windowTabsPanel" Orientation="Horizontal" Margin="3,0"/>
                    <Button x:Name="addWindowBtn" Content="+" Click="AddWindow_Click"
                            Width="22" Height="22"
                            FontSize="14"
                            Background="Transparent"
                            Foreground="{DynamicResource BrushTextMain}"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="添加窗口"
                            Margin="2,0"/>
                </StackPanel>
                <Button x:Name="moreButton" Grid.Column="1" Content="⋯" Click="MoreButton_Click"
                        VerticalAlignment="Center"
                        Width="30" Height="30"
                        FontSize="16" FontWeight="Bold" Padding="5,2"
                        Background="Transparent" Foreground="{DynamicResource BrushTextMain}"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="更多">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="moreMenu" Opened="MoreMenu_Opened">
                            <MenuItem Header="登录" Click="Login_Click"/>
                            <Separator/>
                            <Separator x:Name="menuSeparator1"/>
                            <MenuItem Header="创建小屏" Click="NewSideScreen_Click"/>
                            <MenuItem Header="小屏管理" Click="ScreenManager_Click"/>
                            <MenuItem Header="设置" Click="Settings_Click"/>
                            <MenuItem x:Name="toolsMenu" Header="工具">
                                <MenuItem x:Name="titleLockMenuItem" Header="窗口标题锁定器" Click="TitleLock_Click"/>
                                <MenuItem Header="插件编辑器" Click="PluginEditor_Click"/>
                            </MenuItem>
                            <Separator x:Name="closeWindowSeparator"/>
                            <MenuItem x:Name="closeWindowMenu" Header="关闭面板" Click="CloseWindow_Click"/>
                            <MenuItem Header="退出" Click="Exit_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <controls:SidebarPanel x:Name="sidebarPanel" Grid.Row="1" />

        <!-- 通知栏（浮动覆盖层，不影响布局） -->
        <Border x:Name="notificationBar" Grid.Row="1"
                VerticalAlignment="Top"
                Panel.ZIndex="100"
                Background="{DynamicResource BrushAccent}"
                Padding="8,4"
                Visibility="Visible">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        FontSize="11"
                        Width="18" Height="18"
                        Margin="4,0,0,0"
                        Background="Transparent"
                        Foreground="{DynamicResource BrushAccentText}"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="关闭通知"
                        Click="NotificationClose_Click"/>
                <TextBlock x:Name="notificationText"
                           Text="🔔 示例通知：欢迎使用 元桌小屏！点击查看详情"
                           Foreground="{DynamicResource BrushAccentText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Cursor="Hand"
                           MouseLeftButtonUp="NotificationBar_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</local:AppBarWindow>
