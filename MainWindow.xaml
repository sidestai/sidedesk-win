<local:AppBarWindow x:Class="SideDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SideDesk"
        xmlns:controls="clr-namespace:SideDesk.Controls"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="{l:T common.metadeskScreen}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        Background="{DynamicResource BrushBG}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏（跨两列确保更多按钮始终在右上角） -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource BrushInputBG}"
                MouseEnter="TitleBar_MouseEnter" MouseLeave="TitleBar_MouseLeave">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{l:T common.logIn}" Click="Login_Click"/>
                    <Separator/>
                    <MenuItem Header="{l:T nativePanel.left}" Click="Layout_Left"/>
                    <MenuItem Header="{l:T nativePanel.right}" Click="Layout_Right"/>
                    <MenuItem Header="{l:T common.bothSides}" Click="Layout_Both"/>
                    <Separator/>
                    <MenuItem Header="{l:T common.exit}" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid x:Name="titleBarGrid">
                <Grid.ColumnDefinitions>
                    <!-- 序号徽标列(Auto：保证数字完整不被挤压) / 名称与切换按钮共用弹性列(可截断) / 更多按钮列 -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 当前窗口序号：多窗口平时显示；置于 Auto 列保证数字完整；悬停标题栏时隐藏并展开切换按钮。
                     底色/字色取主题前景与背景色做反相（单色、无蓝块，深浅主题均最高对比） -->
                <Border x:Name="activeIndexBadge" Grid.Column="0" Visibility="Collapsed"
                        VerticalAlignment="Center" Margin="5,0,2,0"
                        Background="{DynamicResource BrushTextMain}" CornerRadius="3" Padding="4,1">
                    <TextBlock x:Name="activeIndexText" Text="1" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource BrushBG}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <!-- 窗口切换按钮：悬停时显示，弹性列内可裁剪，避免挤掉更多按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <StackPanel x:Name="windowTabsPanel" Orientation="Horizontal" Margin="3,0"/>
                    <Button x:Name="addWindowBtn" Content="+" Click="AddWindow_Click"
                            Width="22" Height="22"
                            FontSize="14"
                            Background="Transparent"
                            Foreground="{DynamicResource BrushTextMain}"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="{l:T window.addWindow}"
                            Margin="2,0"/>
                </StackPanel>
                <!-- 产品名：与切换按钮同列(互斥显示)，空间不足时尾部省略，优先保证序号完整 -->
                <TextBlock x:Name="singleWindowTitle" Grid.Column="1" Text="{l:T common.metadeskScreen}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,6,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource BrushTextMain}" FontSize="12"/>
                <Button x:Name="moreButton" Grid.Column="2" Content="⋯" Click="MoreButton_Click"
                        VerticalAlignment="Center"
                        Width="30" Height="30"
                        FontSize="16" FontWeight="Bold" Padding="5,2"
                        Background="Transparent" Foreground="{DynamicResource BrushTextMain}"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="{l:T common.more}">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="moreMenu" Opened="MoreMenu_Opened">
                            <Separator x:Name="menuSeparator1"/>
                            <MenuItem Header="{l:T settings.createScreen}" Click="NewSideScreen_Click"/>
                            <MenuItem Header="{l:T cloudDrive.importShare}" Click="ImportShare_Click"/>
                            <MenuItem Header="{l:T common.addModule}" SubmenuOpened="AddModuleMenu_SubmenuOpened">
                                <MenuItem Header="{l:T nativePanel.loading}"/>
                            </MenuItem>
                            <MenuItem Header="{l:T common.screenManagement}" Click="ScreenManager_Click"/>
                            <MenuItem x:Name="notificationCenterMenu" Header="{l:T common.notificationCenter}" Click="NotificationCenter_Click"/>
                            <MenuItem Header="{l:T common.settings}" Click="Settings_Click"/>
                            <MenuItem x:Name="toolsMenu" Header="{l:T common.tools}" SubmenuOpened="ToolsMenu_SubmenuOpened">
                                <MenuItem Header="{l:T nativePanel.loading}"/>
                            </MenuItem>
                            <Separator x:Name="closeWindowSeparator"/>
                            <MenuItem x:Name="closeWindowMenu" Header="{l:T nativePanel.closePanel}" Click="CloseWindow_Click"/>
                            <MenuItem x:Name="accountMenu" Header="{l:T common.logIn}" Click="AccountMenu_Click"/>
                            <MenuItem Header="{l:T common.exit}" Click="Exit_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <controls:SidebarPanel x:Name="sidebarPanel" Grid.Row="1" Grid.Column="0" />

        <!-- 通知栏（浮动覆盖层，不影响布局）；多条通知垂直堆叠，关闭一条其余自动上移 -->
        <Border x:Name="notificationBar" Grid.Row="1" Grid.Column="0"
                VerticalAlignment="Top"
                Panel.ZIndex="100"
                Background="Transparent"
                Visibility="Collapsed">
            <StackPanel x:Name="notificationStack"/>
        </Border>

        <!-- 气泡提示（好友上/下线等轻量通知，底部浮动，自动淡出） -->
        <StackPanel x:Name="bubbleStack" Grid.Row="1" Grid.Column="0"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Panel.ZIndex="200" Margin="6,0,6,8"/>

        <!-- 浮动上下文窗口（全局：输入框焦点/剪贴板复制触发，内容区垂直拖拽，双击切换精简模式） -->
        <Canvas x:Name="floatingContextLayer" Grid.Row="1" Grid.Column="0" Panel.ZIndex="150">
            <controls:FloatingContextPanel x:Name="floatingContext" Visibility="Collapsed"
                                           Width="{Binding ActualWidth, ElementName=floatingContextLayer}"/>
        </Canvas>

        <!-- 通知条（窗口最右侧约 5px 宽的竖条，展示各种颜色的通知提醒；占据独立布局列，显示时左侧内容区收缩；各通知段可悬停提示、点击处理） -->
        <Border x:Name="notificationStrip" Grid.Column="1" Grid.Row="1"
                Width="5"
                Background="{DynamicResource BrushBorder}"
                Visibility="Visible">
            <StackPanel x:Name="notificationStripPanel" Orientation="Vertical"/>
        </Border>
    </Grid>
</local:AppBarWindow>
