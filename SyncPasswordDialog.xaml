<Window x:Class="SideDesk.SyncPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        Title="{l:T settings.setEncryptedSyncKey}" Height="220" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12" Opacity="0.8"
                   Text="{l:T misc.pleaseEnterYourAccount}"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{l:T common.passwordLabel}" Width="70" VerticalAlignment="Center"/>
            <PasswordBox x:Name="passwordBox" Padding="6,4" Background="{DynamicResource BrushInputBG}"
                         Foreground="{DynamicResource BrushTextMain}"/>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{l:T common.confirmPasswordLabel}" Width="70" VerticalAlignment="Center"/>
            <PasswordBox x:Name="confirmBox" Padding="6,4" Background="{DynamicResource BrushInputBG}"
                         Foreground="{DynamicResource BrushTextMain}"/>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{l:T common.ok}" Width="70" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="{l:T common.cancel}" Width="70" Click="Cancel_Click" IsCancel="True"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
