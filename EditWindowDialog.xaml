<Window x:Class="SideDesk.EditWindowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑窗口" Height="150" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF2D2D30" Foreground="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Text="名称：" Width="50" VerticalAlignment="Center"/>
            <TextBox x:Name="nameBox"
                     Background="#FF3E3E42" Foreground="White"
                     BorderBrush="#FF555555" Padding="3"/>
        </DockPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="70" Margin="0,0,10,0" Click="Ok_Click"
                    Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555" Cursor="Hand"/>
            <Button Content="取消" Width="70" Click="Cancel_Click"
                    Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
