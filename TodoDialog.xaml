<Window x:Class="SideDesk.TodoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        Title="{l:T todo.addTodo}" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <StackPanel Margin="18">
        <TextBlock Text="{l:T common.title}" Margin="0,0,0,4"/>
        <TextBox x:Name="titleBox" Style="{StaticResource GlobalTextBoxStyle}"/>

        <TextBlock Text="{l:T todo.details}" Margin="0,12,0,4"/>
        <TextBox x:Name="descBox" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="80" VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource GlobalTextBoxStyle}"/>

        <CheckBox x:Name="enableTimeCheck" Content="{l:T todo.setTaskTime}" Margin="0,16,0,0"
                  Style="{StaticResource DarkCheckBoxStyle}"
                  Checked="EnableTime_Changed" Unchecked="EnableTime_Changed"/>

        <StackPanel x:Name="timePanel" Visibility="Collapsed" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:T common.date}" Width="45" VerticalAlignment="Center"/>
                <DatePicker x:Name="datePicker" Width="150" Height="36"
                            Style="{StaticResource GlobalDatePickerStyle}"/>
                <TextBox x:Name="timeBox" Width="78" Height="36" Margin="10,0,0,0"
                         ToolTip="{l:T todo.timeFormat24hHint}"
                         Style="{StaticResource GlobalTextBoxStyle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="{l:T common.reminder}" Width="45" VerticalAlignment="Center"/>
                <ComboBox x:Name="remindCombo" Width="238" Height="36"
                          Style="{StaticResource GlobalComboBoxStyle}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="{l:T common.ok}" Width="70" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="{l:T common.cancel}" Width="70" Click="Cancel_Click" IsCancel="True"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
