<Window x:Class="SideDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="420" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BrushBG}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="设置" 
                   FontSize="{DynamicResource FontSizeTitle}" 
                   FontWeight="Bold"
                   Foreground="{DynamicResource BrushTextMain}"
                   Margin="0,0,0,24"/>
        
        <!-- 设置内容 -->
        <StackPanel Grid.Row="1">
            <!-- 主题模式 -->
            <TextBlock Text="主题模式" 
                       Foreground="{DynamicResource BrushTextSec}" 
                       FontSize="{DynamicResource FontSizeSmall}"
                       Margin="0,0,0,8"/>
            <ComboBox x:Name="themeModeCombo" 
                      Style="{StaticResource GlobalComboBoxStyle}"
                      SelectionChanged="ThemeMode_Changed"/>
            
            <!-- 面板宽度 -->
            <TextBlock Text="面板宽度" 
                       Foreground="{DynamicResource BrushTextSec}" 
                       FontSize="{DynamicResource FontSizeSmall}"
                       Margin="0,20,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="widthBox" 
                         Grid.Column="0"
                         Background="{DynamicResource BrushInputBG}"
                         Foreground="{DynamicResource BrushTextMain}"
                         BorderBrush="{DynamicResource BrushBorder}"
                         BorderThickness="1"
                         Padding="10,8"
                         FontSize="{DynamicResource FontSizeNormal}"
                         LostFocus="Width_LostFocus"
                         KeyDown="Width_KeyDown"/>
                <TextBlock Grid.Column="1" Text="px" 
                           Foreground="{DynamicResource BrushTextMuted}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
            
            <!-- 停靠位置 -->
            <TextBlock Text="停靠位置" 
                       Foreground="{DynamicResource BrushTextSec}" 
                       FontSize="{DynamicResource FontSizeSmall}"
                       Margin="0,20,0,8"/>
            <ComboBox x:Name="dockCombo" 
                      Style="{StaticResource GlobalComboBoxStyle}"
                      SelectionChanged="Dock_Changed"/>
        </StackPanel>
    </Grid>
</Window>
