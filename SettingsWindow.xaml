<Window x:Class="SideDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="500" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown"
        Background="{DynamicResource BrushBG}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource BrushInputBG}" 
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 顶部标题 + 团队切换 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,12,20">
                    <DockPanel>
                        <TextBlock Text="设置" 
                                   FontSize="{DynamicResource FontSizeTitle}" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextMain}"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="corpSelectorCombo" DockPanel.Dock="Right"
                                  Style="{StaticResource GlobalComboBoxStyle}"
                                  Width="90" Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CorpSelector_Changed"/>
                    </DockPanel>
                </StackPanel>
                
                <!-- 导航列表 -->
                <ListBox x:Name="navList" 
                         Background="Transparent" 
                         BorderThickness="0"
                         Foreground="{DynamicResource BrushTextMain}"
                         ItemContainerStyle="{StaticResource GlobalListBoxItemStyle}"
                         SelectionChanged="Nav_Changed"
                         Padding="8,0">
                    <ListBoxItem Content="常规" IsSelected="True"/>
                    <ListBoxItem Content="小屏窗口"/>
                    <ListBoxItem Content="账户"/>
                    <ListBoxItem Content="团队"/>
                    <ListBoxItem Content="好友"/>
                    <ListBoxItem Content="云空间"/>
                    <ListBoxItem Content="外观"/>
                    <ListBoxItem Content="程序管理"/>
                    <ListBoxItem Content="扩展管理"/>
                    <ListBoxItem Content="插件"/>
                    <ListBoxItem Content="工具"/>
                    <ListBoxItem Content="模块"/>
                    <ListBoxItem Content="快捷键"/>
                    <ListBoxItem Content="关于"/>
                    <ListBoxItem Content="开发者"/>
                </ListBox>
            </DockPanel>
        </Border>
        
        <!-- 右侧内容区 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30,20">
            <Grid>
                <!-- 常规页面 -->
                <StackPanel x:Name="pageGeneral">
                    <TextBlock Text="常规" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <!-- 停靠配置（每显示器一个卡片，代码动态生成） -->
                    <StackPanel x:Name="dockConfigContainer"/>

                    <!-- 虚拟桌面独立配置开关 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="perVirtualDesktopSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="PerVirtualDesktopSwitch_Changed"
                                          Unchecked="PerVirtualDesktopSwitch_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="虚拟桌面独立配置"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="开启后每个虚拟桌面可独立设置停靠布局、宽度等参数"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- 桌面选择器（仅开启时显示） -->
                            <StackPanel x:Name="desktopSelectorPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,12"/>
                                <DockPanel>
                                    <TextBlock Text="当前编辑桌面" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               DockPanel.Dock="Left"/>
                                    <ComboBox x:Name="desktopSelectorCombo" Width="120"
                                              Style="{StaticResource GlobalComboBoxStyle}"
                                              SelectionChanged="DesktopSelector_Changed"
                                              DockPanel.Dock="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 账户页面 -->
                <StackPanel x:Name="pageAccount" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="账户"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>

                    <!-- 个人资料卡片（含登录状态） -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 个人资料详情（仅登录后显示） -->
                            <StackPanel x:Name="accountProfileSection" Visibility="Collapsed">
                                <TextBlock Text="个人资料"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                                <DockPanel>
                                    <!-- 头像（点击更换） -->
                                    <Border Width="64" Height="64" CornerRadius="32"
                                            Background="{DynamicResource BrushAccent}"
                                            DockPanel.Dock="Left" Margin="0,0,16,0"
                                            Cursor="Hand" MouseLeftButtonUp="AccountAvatar_Click"
                                            ToolTip="点击更换头像">
                                        <Grid>
                                            <TextBlock x:Name="accountAvatarFallbackText" Text="?"
                                                       Foreground="White" FontSize="26"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border x:Name="accountAvatarImageHost" CornerRadius="32" Visibility="Collapsed">
                                                <Border.Background>
                                                    <ImageBrush x:Name="accountAvatarImageBrush" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- 昵称编辑 -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="昵称"
                                                   Foreground="{DynamicResource BrushTextMuted}"
                                                   FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6"/>
                                        <DockPanel>
                                            <Button x:Name="saveNicknameBtn" Content="保存" DockPanel.Dock="Right"
                                                    Click="SaveNickname_Click"
                                                    Style="{DynamicResource PrimaryButtonStyle}"
                                                    Padding="14,6" Height="30" Margin="8,0,0,0"/>
                                            <TextBox x:Name="nicknameBox"
                                                     Style="{StaticResource GlobalTextBoxStyle}"
                                                     Height="30" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            </StackPanel>
                            <!-- 登录状态 -->
                            <DockPanel>
                                <Button x:Name="accountActionBtn" DockPanel.Dock="Right" Content="登录"
                                        Click="AccountAction_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Padding="16,6" Height="32" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="accountStatusText" Text="未登录"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="accountSubText" Text="登录后可开启云同步备份"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 云同步卡片 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="cloudSyncSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="CloudSyncSwitch_Changed"
                                          Unchecked="CloudSyncSwitch_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="云同步"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="开启后每 30 分钟自动把本地全部配置备份到服务器，并在退出时再同步一次"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="cloudSyncStatusText" Text="尚未同步"
                                           Foreground="{DynamicResource BrushTextSec}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="syncNowBtn" Grid.Column="1" Content="立即同步"
                                        Click="SyncNow_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="14,6" Height="30"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            <!-- 加密同步 -->
                            <DockPanel>
                                <CheckBox x:Name="encryptSyncSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="EncryptSyncSwitch_Changed"
                                          Unchecked="EncryptSyncSwitch_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="加密同步"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"/>
                                    <TextBlock Text="敏感设置（云盘密钥、Token）加密后再上传，基于登录密码派生密钥"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            <!-- 恢复设置 -->
                            <DockPanel>
                                <Button x:Name="restoreSettingsBtn" DockPanel.Dock="Right" Content="从云端恢复"
                                        Click="RestoreSettings_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="14,6" Height="30"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="恢复设置"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"/>
                                    <TextBlock Text="从服务器拉取已同步的设置覆盖本地（换电脑后使用）"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 本地备份 / 导出 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="备份与导出"
                                       Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="在本地保存最近一次的配置快照（仅保留最后一个），可随时点“恢复”还原；导出可将全部配置保存为 JSON 文件。"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeTiny}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="backupStatusText" Text="尚无本地备份"
                                           Foreground="{DynamicResource BrushTextSec}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="备份" Click="Backup_Click"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="14,6" Height="30" Margin="0,0,8,0"/>
                                    <Button x:Name="restoreBtn" Content="恢复" Click="Restore_Click"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="14,6" Height="30" Margin="0,0,8,0"/>
                                    <Button Content="导出配置" Click="ExportConfig_Click"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="14,6" Height="30"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- 云空间页面 -->
                <StackPanel x:Name="pageCloudSpaces" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="云空间"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="管理常用网盘/云存储入口，系统已内置常见云盘，可自由添加或删除"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="cloudSpaceListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ 添加云空间" Click="AddCloudSpace_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="恢复内置" Click="RestoreBuiltinSpaces_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"
                                ToolTip="将缺失的内置云盘预设补回列表"/>
                    </StackPanel>
                </StackPanel>

                <!-- 团队页面 -->
                <StackPanel x:Name="pageTeams" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="团队"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="管理所属团队，查看团队成员"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="teamListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ 添加团队" Click="AddTeam_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6" Margin="0,0,8,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 好友页面 -->
                <StackPanel x:Name="pageFriends" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="好友"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="friendPageSubtitle" Text="通过用户名、邮箱、手机号或好友码搜索添加好友"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,0,16"/>

                    <!-- 搜索添加区 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="添加好友" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,8"/>
                            <DockPanel>
                                <Button x:Name="friendSearchBtn" Content="搜索" DockPanel.Dock="Right"
                                        Style="{StaticResource GhostButtonStyle}" Padding="14,6" Margin="8,0,0,0"
                                        Click="FriendSearch_Click"/>
                                <TextBox x:Name="friendSearchBox"
                                         Style="{StaticResource GlobalTextBoxStyle}"
                                         KeyDown="FriendSearchBox_KeyDown"/>
                            </DockPanel>
                            <StackPanel x:Name="friendSearchResultPanel" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 好友请求区 -->
                    <Border x:Name="friendRequestSection" Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="好友请求" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="friendRequestPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- 好友列表区 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="我的好友" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="friendListPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- 允许被搜索添加好友 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12">
                        <DockPanel>
                            <CheckBox x:Name="allowFriendSearchSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="AllowFriendSearch_Changed"
                                      Unchecked="AllowFriendSearch_Changed"/>
                            <StackPanel>
                                <TextBlock Text="允许被搜索添加好友" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextMain}"/>
                                <TextBlock Text="关闭后别人无法搜索到你，同时清空好友码"
                                           FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 我的好友码 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,12,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="refreshFriendCodeBtn" Content="换一换"
                                        Style="{StaticResource GhostButtonStyle}" Padding="14,6" Margin="8,0,0,0"
                                        Click="RefreshFriendCode_Click"/>
                                <Button x:Name="copyFriendCodeBtn" Content="复制"
                                        Style="{StaticResource GhostButtonStyle}" Padding="14,6" Margin="8,0,0,0"
                                        Click="CopyFriendCode_Click"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="我的好友码" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextMain}"/>
                                <TextBlock x:Name="myFriendCodeText" Text="加载中..."
                                           FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{DynamicResource BrushAccent}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 外观页面 -->
                <StackPanel x:Name="pageAppearance" Visibility="Collapsed">
                    <TextBlock Text="外观" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <!-- 主题模式 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="主题模式" Foreground="{DynamicResource BrushTextMain}" 
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="选择界面的颜色主题" Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="themeModeCombo" Grid.Column="1" Width="120"
                                  Style="{StaticResource GlobalComboBoxStyle}"
                                  SelectionChanged="ThemeMode_Changed"/>
                    </Grid>

                    <!-- 配色主题（JSON 自定义主题） -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="配色主题" Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="从 resources/themes 加载的自定义配色方案" Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="customThemeCombo" Grid.Column="1" Width="160"
                                  Style="{StaticResource GlobalComboBoxStyle}"
                                  SelectionChanged="CustomTheme_Changed"/>
                    </Grid>

                    <!-- 背景透明度 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="背景透明度" Foreground="{DynamicResource BrushTextMain}" 
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="侧边面板背景的透明度（0-100%）" Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="bgOpacityBox" Width="70"
                                     Style="{StaticResource GlobalTextBoxStyle}"
                                     TextAlignment="Center"
                                     LostFocus="BgOpacity_LostFocus"
                                     KeyDown="BgOpacity_KeyDown"/>
                            <TextBlock Text="%" Foreground="{DynamicResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 隐藏模块外框时同时隐藏标题 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="隐藏模块外框时同时隐藏模块标题" Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="开启后，模块隐藏外框时一并隐藏其标题栏" Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="hideModuleTitleSwitch" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource RaycastSwitchStyle}"
                                  Checked="HideModuleTitleSwitch_Changed"
                                  Unchecked="HideModuleTitleSwitch_Changed"/>
                    </Grid>

                    <!-- 显示通知条 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="显示通知条" Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="在窗口最右侧显示约 5px 宽的通知条，展示各种颜色的通知提醒" Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="showNotificationStripSwitch" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource RaycastSwitchStyle}"
                                  Checked="ShowNotificationStripSwitch_Changed"
                                  Unchecked="ShowNotificationStripSwitch_Changed"/>
                    </Grid>
                </StackPanel>
                
                <!-- 程序管理页面 -->
                <StackPanel x:Name="pageProgramManager" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="程序管理" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <!-- 已注册程序 -->
                    <TextBlock Text="已注册程序" 
                               FontSize="{DynamicResource FontSizeNormal}" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="维护可用程序列表，添加快捷项时可从中选取" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,12"/>
                    
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="6" 
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="programListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button Content="+ 添加程序" Click="AddProgram_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>
                    
                    <!-- 浏览器配置 -->
                    <TextBlock Text="浏览器配置" 
                               FontSize="{DynamicResource FontSizeNormal}" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="配置多个浏览器及其 UserData 目录，添加网址快捷项时可选择使用" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,12"/>
                    
                    <!-- 默认 Profile 目录 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="默认 Profile 目录" Foreground="{DynamicResource BrushTextMain}" 
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text=" ℹ" FontSize="13" Foreground="{DynamicResource BrushAccent}" 
                                       VerticalAlignment="Center" Cursor="Help"
                                       ToolTip="当需要自动新建 Profile 时，将在此目录下新建子目录作为浏览器 UserData"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="profileBaseDirText" 
                                       Text="未设置" 
                                       Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       VerticalAlignment="Center"
                                       MaxWidth="200" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,8,0"/>
                            <Button Content="选择" Click="SelectProfileBaseDir_Click"
                                    Style="{StaticResource GhostButtonStyle}" Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel x:Name="browserListPanel"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ 添加浏览器" Click="AddBrowser_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 扩展管理页面 -->
                <StackPanel x:Name="pageExtensions" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="扩展管理" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="管理已创建的扩展，或新建扩展" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,16"/>
                    
                    <StackPanel x:Name="extensionListPanel"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="+ 新建扩展" Click="NewExtension_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 插件管理页面 -->
                <StackPanel x:Name="pagePlugins" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="插件" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="管理插件目录下的插件，关闭后不再加载" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,16"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="↻ 刷新列表" Click="RefreshPluginList_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>

                    <StackPanel x:Name="pluginListPanel"/>
                </StackPanel>
                
                <!-- 工具页面 -->
                <StackPanel x:Name="pageTools" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="工具" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="内置实用工具" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,20"/>
                    
                    <!-- 任务栏标题锁定 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="立即设置" Click="TaskbarOverlayButton_Click"
                                        Style="{StaticResource GhostButtonStyle}" 
                                        Padding="10,6" Margin="0,0,12,0"/>
                                <CheckBox x:Name="titleLockSwitch" 
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="TitleLockSwitch_Changed" 
                                          Unchecked="TitleLockSwitch_Changed"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="任务栏标题锁定" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="锁定指定窗口在任务栏显示的标题文字，开启后启动时自动恢复" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- MCP 服务器 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="mcpServerSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="McpServerSwitch_Changed" 
                                      Unchecked="McpServerSwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MCP 服务器" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="开启后在 127.0.0.1:19192 提供 MCP 协议接口，供 AI 助手调用" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- HTTP 服务器 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="httpServerSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="HttpServerSwitch_Changed" 
                                      Unchecked="HttpServerSwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HTTP 服务器" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="默认开启。在 127.0.0.1 提供本地 HTTP 接口，外部工具/脚本可查询状态、推送通知" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="端口：" Foreground="{DynamicResource BrushTextSec}" 
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="httpPortBox" Width="70" FontSize="12" Padding="4,3"
                                             Text="19195" LostFocus="HttpPort_LostFocus" KeyDown="HttpPort_KeyDown"/>
                                    <TextBlock x:Name="httpServerStatusText" Text="" 
                                               Foreground="{DynamicResource BrushTextMuted}" 
                                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 窗口使用时长统计 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="usageStatsSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="UsageStatsSwitch_Changed"
                                      Unchecked="UsageStatsSwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="窗口使用时长统计"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="开启后在后台记录各应用的使用时长，可在小屏「使用时长分析」中查看"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
                
                <!-- 模块页面 -->
                <StackPanel x:Name="pageModules" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="模块" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="管理数据看板等模块的配置" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,20"/>
                    
                    <!-- 数据模块连接方式 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Web 数据获取方式" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"/>
                                <TextBlock Text=" ❓" FontSize="12" Cursor="Help" VerticalAlignment="Center"
                                           ToolTip="浏览器插件模式：通过浏览器插件 + WebSocket(19191) 获取数据&#x0a;CDP 连接模式：直连已运行的浏览器（需开启 --remote-debugging-port）"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                            </StackPanel>
                            <RadioButton x:Name="rbModeExtension" Content="浏览器插件模式" GroupName="DataFetchMode"
                                         Foreground="{DynamicResource BrushTextMain}" FontSize="13"
                                         Margin="0,0,0,6" Checked="DataFetchMode_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="rbModeCdp" Content="CDP 连接模式" GroupName="DataFetchMode"
                                             Foreground="{DynamicResource BrushTextMain}" FontSize="13"
                                             VerticalAlignment="Center" Checked="DataFetchMode_Changed"/>
                                <Button Content="测试连接" Click="TestCdpConnection_Click"
                                        Style="{StaticResource GhostButtonStyle}" Padding="8,3"
                                        FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- CDP 端口配置（仅 CDP 模式显示） -->
                            <StackPanel x:Name="cdpPortSection" Orientation="Horizontal" Visibility="Collapsed" Margin="20,0,0,0">
                                <TextBlock Text="调试端口：" Foreground="{DynamicResource BrushTextSec}" 
                                           FontSize="12" VerticalAlignment="Center"/>
                                <TextBox x:Name="cdpPortBox" Width="70" FontSize="12" Padding="4,3"
                                         Text="9222" LostFocus="CdpPort_LostFocus"/>
                                <TextBlock Text="（浏览器启动参数 --remote-debugging-port）" 
                                           Foreground="{DynamicResource BrushTextMuted}" 
                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- 我的数据看板 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="我的数据看板" 
                                       FontSize="{DynamicResource FontSizeNormal}" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMain}"/>
                            <TextBlock Text="统一轮询数据源（面板组件仅展示，可添加不在面板显示的后台数据项）" 
                                       Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="隐藏浏览器:" Foreground="{DynamicResource BrushTextSec}" 
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="hiddenBrowserModeCombo" Width="90" FontSize="11"
                                      SelectionChanged="HiddenBrowserMode_Changed">
                                <ComboBoxItem Content="无头模式" Tag="headless"/>
                                <ComboBoxItem Content="隐藏窗口" Tag="hidden"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="6" 
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="dashboardItemListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="+ 添加后台数据项" Click="AddBackgroundDashItem_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>

                    <!-- 数据模版 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="数据模版" 
                                       FontSize="{DynamicResource FontSizeNormal}" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMain}"/>
                            <TextBlock Text="管理数据看板使用的模版列表，支持内置模版和自定义模版" 
                                       Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="查看连接" Click="ViewWsClients_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                                VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="6" 
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="templateListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Button Content="+ 新建模版" Click="AddTemplate_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                        <Button Content="⬇ 从数据看板导入" Click="ImportFromDashboard_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 快捷键页面 -->
                <StackPanel x:Name="pageShortcuts" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="快捷键" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="全局快捷键配置" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,20"/>

                    <!-- Ctrl + 数字 切换窗口 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="windowSwitchHotkeySwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="WindowSwitchHotkeySwitch_Changed" 
                                      Unchecked="WindowSwitchHotkeySwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + 数字 切换窗口" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="全局按 Ctrl+1~9（含小键盘）快速切换到对应序号的窗口标签" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="注：开启后会拦截该快捷键，可能与浏览器/编辑器的 Ctrl+数字切标签冲突" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 小屏窗口管理页面 -->
                <StackPanel x:Name="pageWindows" Visibility="Collapsed">
                    <TextBlock Text="小屏窗口" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>

                    <!-- 操作按钮栏 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="📥 导入窗口" Style="{StaticResource GhostButtonStyle}" 
                                Padding="12,6" Click="ImportWindow_Click" Margin="0,0,8,0"/>
                        <Button Content="🔗 我的分享" Style="{StaticResource GhostButtonStyle}" 
                                Padding="12,6" Click="MyShares_Click"/>
                    </StackPanel>

                    <!-- 窗口列表（代码动态生成） -->
                    <StackPanel x:Name="windowListPanel"/>
                </StackPanel>

                <!-- 关于页面 -->
                <StackPanel x:Name="pageAbout" Visibility="Collapsed">
                    <TextBlock Text="关于" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <TextBlock Text="元桌小屏" 
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="versionText" Text="版本 v1.0.0" 
                               Foreground="{DynamicResource BrushTextSec}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="一款轻量级的桌面侧边栏工具，帮助你高效管理窗口和快捷方式。" 
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <!-- 自动更新区域 -->
                    <Border Background="{DynamicResource BrushBG}" CornerRadius="8" 
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 自动更新开关 -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="启动时自动检测和下载更新" 
                                           Foreground="{DynamicResource BrushTextMain}" 
                                           FontSize="{DynamicResource FontSizeNormal}" 
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="autoUpdateSwitch" HorizontalAlignment="Right" 
                                          Style="{DynamicResource RaycastSwitchStyle}" 
                                          Click="AutoUpdateSwitch_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,12"/>

                            <!-- 检查更新按钮 + 状态文字 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="updateStatusText" Text="点击检查是否有新版本" 
                                           Foreground="{DynamicResource BrushTextSec}" 
                                           FontSize="{DynamicResource FontSizeNormal}" 
                                           VerticalAlignment="Center"/>
                                <Button x:Name="checkUpdateBtn" Grid.Column="1" Content="检查更新" 
                                        Click="CheckForUpdates_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Padding="14,6" Height="30"/>
                            </Grid>

                            <!-- 下载进度条（初始隐藏） -->
                            <StackPanel x:Name="downloadProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="正在下载更新..." 
                                               Foreground="{DynamicResource BrushTextMain}" 
                                               FontSize="{DynamicResource FontSizeNormal}"/>
                                    <TextBlock x:Name="progressPercentText" Text="0%" 
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource BrushAccent}" 
                                               FontSize="{DynamicResource FontSizeNormal}" 
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <ProgressBar x:Name="downloadProgressBar" Value="0" 
                                             Height="6" Minimum="0" Maximum="100" 
                                             BorderThickness="0" 
                                             Background="{DynamicResource BrushInputBG}" 
                                             Foreground="{DynamicResource BrushAccent}"/>
                            </StackPanel>

                            <!-- 应用更新并重启按钮（初始隐藏） -->
                            <Grid x:Name="applyUpdatePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="新版就绪，重启即可生效！" 
                                           Foreground="#FF22C55E" 
                                           FontSize="{DynamicResource FontSizeNormal}" 
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="立即重启并应用" 
                                        Click="ApplyUpdateAndRestart_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Padding="14,6" Height="30"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 开发者页面 -->
                <StackPanel x:Name="pageDeveloper" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="开发者"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
