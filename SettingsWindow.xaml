<Window x:Class="SideDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="500" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BrushBG}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource BrushInputBG}" 
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 顶部标题 -->
                <TextBlock DockPanel.Dock="Top" Text="设置" 
                           FontSize="{DynamicResource FontSizeTitle}" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextMain}"
                           Margin="20,20,20,20"/>
                
                <!-- 导航列表 -->
                <ListBox x:Name="navList" 
                         Background="Transparent" 
                         BorderThickness="0"
                         Foreground="{DynamicResource BrushTextMain}"
                         ItemContainerStyle="{StaticResource GlobalListBoxItemStyle}"
                         SelectionChanged="Nav_Changed"
                         Padding="8,0">
                    <ListBoxItem Content="常规" IsSelected="True"/>
                    <ListBoxItem Content="账户"/>
                    <ListBoxItem Content="团队"/>
                    <ListBoxItem Content="云空间"/>
                    <ListBoxItem Content="外观"/>
                    <ListBoxItem Content="程序管理"/>
                    <ListBoxItem Content="扩展管理"/>
                    <ListBoxItem Content="工具"/>
                    <ListBoxItem Content="模块"/>
                    <ListBoxItem Content="快捷键"/>
                    <ListBoxItem Content="关于"/>
                </ListBox>
            </DockPanel>
        </Border>
        
        <!-- 右侧内容区 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30,20">
            <Grid>
                <!-- 常规页面 -->
                <StackPanel x:Name="pageGeneral">
                    <TextBlock Text="常规" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <!-- 停靠配置（每显示器一个卡片，代码动态生成） -->
                    <StackPanel x:Name="dockConfigContainer"/>

                    <!-- 虚拟桌面独立配置开关 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="perVirtualDesktopSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="PerVirtualDesktopSwitch_Changed"
                                          Unchecked="PerVirtualDesktopSwitch_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="虚拟桌面独立配置"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="开启后每个虚拟桌面可独立设置停靠布局、宽度等参数"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- 桌面选择器（仅开启时显示） -->
                            <StackPanel x:Name="desktopSelectorPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,12"/>
                                <DockPanel>
                                    <TextBlock Text="当前编辑桌面" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               DockPanel.Dock="Left"/>
                                    <ComboBox x:Name="desktopSelectorCombo" Width="120"
                                              Style="{StaticResource GlobalComboBoxStyle}"
                                              SelectionChanged="DesktopSelector_Changed"
                                              DockPanel.Dock="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 账户页面 -->
                <StackPanel x:Name="pageAccount" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="账户"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>

                    <!-- 登录状态卡片 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,16">
                        <DockPanel>
                            <Button x:Name="accountActionBtn" DockPanel.Dock="Right" Content="登录"
                                    Click="AccountAction_Click"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Padding="16,6" Height="32" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="accountStatusText" Text="未登录"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="accountSubText" Text="登录后可开启云同步备份"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 云同步卡片 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="cloudSyncSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="CloudSyncSwitch_Changed"
                                          Unchecked="CloudSyncSwitch_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="云同步"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="开启后每 30 分钟自动把本地全部配置备份到服务器，并在退出时再同步一次"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="cloudSyncStatusText" Text="尚未同步"
                                           Foreground="{DynamicResource BrushTextSec}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="syncNowBtn" Grid.Column="1" Content="立即同步"
                                        Click="SyncNow_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="14,6" Height="30"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 本地备份 / 导出 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="备份与导出"
                                       Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="在本地保存最近一次的配置快照（仅保留最后一个），可随时点“恢复”还原；导出可将全部配置保存为 JSON 文件。"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeTiny}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="backupStatusText" Text="尚无本地备份"
                                           Foreground="{DynamicResource BrushTextSec}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="备份" Click="Backup_Click"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="14,6" Height="30" Margin="0,0,8,0"/>
                                    <Button x:Name="restoreBtn" Content="恢复" Click="Restore_Click"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="14,6" Height="30" Margin="0,0,8,0"/>
                                    <Button Content="导出配置" Click="ExportConfig_Click"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="14,6" Height="30"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- 云空间页面 -->
                <StackPanel x:Name="pageCloudSpaces" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="云空间"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="管理常用网盘/云存储入口，系统已内置常见云盘，可自由添加或删除"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="cloudSpaceListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ 添加云空间" Click="AddCloudSpace_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="恢复内置" Click="RestoreBuiltinSpaces_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"
                                ToolTip="将缺失的内置云盘预设补回列表"/>
                    </StackPanel>
                </StackPanel>

                <!-- 团队页面 -->
                <StackPanel x:Name="pageTeams" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="团队"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="管理所属团队，查看团队成员"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="teamListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ 添加团队" Click="AddTeam_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6" Margin="0,0,8,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 外观页面 -->
                <StackPanel x:Name="pageAppearance" Visibility="Collapsed">
                    <TextBlock Text="外观" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <!-- 主题模式 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="主题模式" Foreground="{DynamicResource BrushTextMain}" 
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="选择界面的颜色主题" Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="themeModeCombo" Grid.Column="1" Width="120"
                                  Style="{StaticResource GlobalComboBoxStyle}"
                                  SelectionChanged="ThemeMode_Changed"/>
                    </Grid>

                    <!-- 背景透明度 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="背景透明度" Foreground="{DynamicResource BrushTextMain}" 
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="侧边面板背景的透明度（0-100%）" Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="bgOpacityBox" Width="70"
                                     Style="{StaticResource GlobalTextBoxStyle}"
                                     TextAlignment="Center"
                                     LostFocus="BgOpacity_LostFocus"
                                     KeyDown="BgOpacity_KeyDown"/>
                            <TextBlock Text="%" Foreground="{DynamicResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 隐藏模块外框时同时隐藏标题 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="隐藏模块外框时同时隐藏模块标题" Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="开启后，模块隐藏外框时一并隐藏其标题栏" Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="hideModuleTitleSwitch" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource RaycastSwitchStyle}"
                                  Checked="HideModuleTitleSwitch_Changed"
                                  Unchecked="HideModuleTitleSwitch_Changed"/>
                    </Grid>
                </StackPanel>
                
                <!-- 程序管理页面 -->
                <StackPanel x:Name="pageProgramManager" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="程序管理" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <!-- 已注册程序 -->
                    <TextBlock Text="已注册程序" 
                               FontSize="{DynamicResource FontSizeNormal}" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="维护可用程序列表，添加快捷项时可从中选取" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,12"/>
                    
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="6" 
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="programListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button Content="+ 添加程序" Click="AddProgram_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>
                    
                    <!-- 浏览器配置 -->
                    <TextBlock Text="浏览器配置" 
                               FontSize="{DynamicResource FontSizeNormal}" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="配置多个浏览器及其 UserData 目录，添加网址快捷项时可选择使用" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,12"/>
                    
                    <!-- 默认 Profile 目录 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="默认 Profile 目录" Foreground="{DynamicResource BrushTextMain}" 
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text=" ℹ" FontSize="13" Foreground="{DynamicResource BrushAccent}" 
                                       VerticalAlignment="Center" Cursor="Help"
                                       ToolTip="当需要自动新建 Profile 时，将在此目录下新建子目录作为浏览器 UserData"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="profileBaseDirText" 
                                       Text="未设置" 
                                       Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       VerticalAlignment="Center"
                                       MaxWidth="200" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,8,0"/>
                            <Button Content="选择" Click="SelectProfileBaseDir_Click"
                                    Style="{StaticResource GhostButtonStyle}" Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel x:Name="browserListPanel"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ 添加浏览器" Click="AddBrowser_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 扩展管理页面 -->
                <StackPanel x:Name="pageExtensions" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="扩展管理" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="管理已创建的扩展，或新建扩展" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,16"/>
                    
                    <StackPanel x:Name="extensionListPanel"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="+ 新建扩展" Click="NewExtension_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 工具页面 -->
                <StackPanel x:Name="pageTools" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="工具" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="内置实用工具" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,20"/>
                    
                    <!-- 任务栏标题锁定 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="立即设置" Click="TaskbarOverlayButton_Click"
                                        Style="{StaticResource GhostButtonStyle}" 
                                        Padding="10,6" Margin="0,0,12,0"/>
                                <CheckBox x:Name="titleLockSwitch" 
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="TitleLockSwitch_Changed" 
                                          Unchecked="TitleLockSwitch_Changed"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="任务栏标题锁定" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="锁定指定窗口在任务栏显示的标题文字，开启后启动时自动恢复" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- MCP 服务器 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="mcpServerSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="McpServerSwitch_Changed" 
                                      Unchecked="McpServerSwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MCP 服务器" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="开启后在 127.0.0.1:19192 提供 MCP 协议接口，供 AI 助手调用" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
                
                <!-- 模块页面 -->
                <StackPanel x:Name="pageModules" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="模块" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="管理数据看板等模块的配置" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,20"/>
                    
                    <!-- 数据模版 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="数据模版" 
                                       FontSize="{DynamicResource FontSizeNormal}" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMain}"/>
                            <TextBlock Text="管理数据看板使用的模版列表，支持内置模版和自定义模版" 
                                       Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="查看连接" Click="ViewWsClients_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                                VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="6" 
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="templateListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Button Content="+ 新建模版" Click="AddTemplate_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 快捷键页面 -->
                <StackPanel x:Name="pageShortcuts" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="快捷键" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="全局快捷键配置" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,20"/>

                    <!-- Ctrl + 数字 切换窗口 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="windowSwitchHotkeySwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="WindowSwitchHotkeySwitch_Changed" 
                                      Unchecked="WindowSwitchHotkeySwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + 数字 切换窗口" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="全局按 Ctrl+1~9（含小键盘）快速切换到对应序号的窗口标签" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="注：开启后会拦截该快捷键，可能与浏览器/编辑器的 Ctrl+数字切标签冲突" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 关于页面 -->
                <StackPanel x:Name="pageAbout" Visibility="Collapsed">
                    <TextBlock Text="关于" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <TextBlock Text="元桌小屏" 
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="versionText" Text="版本 v1.0.0" 
                               Foreground="{DynamicResource BrushTextSec}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="一款轻量级的桌面侧边栏工具，帮助你高效管理窗口和快捷方式。" 
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <!-- 自动更新区域 -->
                    <Border Background="{DynamicResource BrushBG}" CornerRadius="8" 
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 自动更新开关 -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="启动时自动检测和下载更新" 
                                           Foreground="{DynamicResource BrushTextMain}" 
                                           FontSize="{DynamicResource FontSizeNormal}" 
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="autoUpdateSwitch" HorizontalAlignment="Right" 
                                          Style="{DynamicResource RaycastSwitchStyle}" 
                                          Click="AutoUpdateSwitch_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,12"/>

                            <!-- 检查更新按钮 + 状态文字 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="updateStatusText" Text="点击检查是否有新版本" 
                                           Foreground="{DynamicResource BrushTextSec}" 
                                           FontSize="{DynamicResource FontSizeNormal}" 
                                           VerticalAlignment="Center"/>
                                <Button x:Name="checkUpdateBtn" Grid.Column="1" Content="检查更新" 
                                        Click="CheckForUpdates_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Padding="14,6" Height="30"/>
                            </Grid>

                            <!-- 下载进度条（初始隐藏） -->
                            <StackPanel x:Name="downloadProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="正在下载更新..." 
                                               Foreground="{DynamicResource BrushTextMain}" 
                                               FontSize="{DynamicResource FontSizeNormal}"/>
                                    <TextBlock x:Name="progressPercentText" Text="0%" 
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource BrushAccent}" 
                                               FontSize="{DynamicResource FontSizeNormal}" 
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <ProgressBar x:Name="downloadProgressBar" Value="0" 
                                             Height="6" Minimum="0" Maximum="100" 
                                             BorderThickness="0" 
                                             Background="{DynamicResource BrushInputBG}" 
                                             Foreground="{DynamicResource BrushAccent}"/>
                            </StackPanel>

                            <!-- 应用更新并重启按钮（初始隐藏） -->
                            <Grid x:Name="applyUpdatePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="新版就绪，重启即可生效！" 
                                           Foreground="#FF22C55E" 
                                           FontSize="{DynamicResource FontSizeNormal}" 
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="立即重启并应用" 
                                        Click="ApplyUpdateAndRestart_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Padding="14,6" Height="30"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
