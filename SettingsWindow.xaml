<Window x:Class="SideDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF2D2D30" Foreground="White">
    <DockPanel Margin="15">
        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="保存" Width="70" Margin="0,0,10,0" Click="Save_Click"
                    Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555" Cursor="Hand"/>
            <Button Content="取消" Width="70" Click="Cancel_Click"
                    Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555" Cursor="Hand"/>
        </StackPanel>
        
        <!-- 设置内容区 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="settingsPanel">
                <!-- 面板宽度 -->
                <TextBlock Text="面板宽度" Margin="0,0,0,5" FontWeight="Bold"/>
                <DockPanel Margin="0,0,0,15">
                    <TextBlock Text="宽度(px)：" Width="80" VerticalAlignment="Center"/>
                    <TextBox x:Name="widthBox" Text="105" 
                             Background="#FF3E3E42" Foreground="White" 
                             BorderBrush="#FF555555" Padding="3"/>
                </DockPanel>
                
                <!-- 停靠位置 -->
                <TextBlock Text="停靠位置" Margin="0,0,0,5" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <RadioButton x:Name="dockLeftRadio" Content="左侧" Foreground="White" Margin="0,0,15,0"/>
                    <RadioButton x:Name="dockRightRadio" Content="右侧" Foreground="White" Margin="0,0,15,0"/>
                    <RadioButton x:Name="dockBothRadio" Content="双侧" Foreground="White"/>
                </StackPanel>
                
                <!-- 主题 -->
                <TextBlock Text="主题" Margin="0,0,0,5" FontWeight="Bold"/>
                <ComboBox x:Name="themeCombo" Margin="0,0,0,15"
                          Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555"/>
                
                <!-- 预留更多设置项的空间 -->
                <TextBlock Text="更多设置项待添加..." Foreground="Gray" Opacity="0.5" Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
