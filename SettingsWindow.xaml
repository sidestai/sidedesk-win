<Window x:Class="SideDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="{l:T common.settings}" Height="500" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown"
        Background="{DynamicResource BrushBG}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource BrushInputBG}" 
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 顶部标题 + 团队切换 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,12,20">
                    <DockPanel>
                        <TextBlock Text="{l:T common.settings}" 
                                   FontSize="{DynamicResource FontSizeTitle}" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextMain}"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="corpSelectorCombo" DockPanel.Dock="Right"
                                  Style="{StaticResource GlobalComboBoxStyle}"
                                  Width="90" Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CorpSelector_Changed"/>
                    </DockPanel>
                </StackPanel>
                
                <!-- 导航列表 -->
                <ListBox x:Name="navList" 
                         Background="Transparent" 
                         BorderThickness="0"
                         Foreground="{DynamicResource BrushTextMain}"
                         ItemContainerStyle="{StaticResource GlobalListBoxItemStyle}"
                         SelectionChanged="Nav_Changed"
                         Padding="8,0">
                    <ListBoxItem Content="{l:T settings.general}" IsSelected="True"/>
                    <ListBoxItem Content="{l:T common.screenWindow}"/>
                    <ListBoxItem Content="{l:T common.account}"/>
                    <ListBoxItem Content="{l:T common.team}"/>
                    <ListBoxItem Content="{l:T common.friends}"/>
                    <ListBoxItem Content="{l:T common.cloudSpace}"/>
                    <ListBoxItem Content="{l:T common.appearance}"/>
                    <ListBoxItem Content="{l:T settings.programManagement}"/>
                    <ListBoxItem Content="{l:T common.plugins}"/>
                    <ListBoxItem Content="{l:T common.tools}"/>
                    <ListBoxItem Content="{l:T common.module}"/>
                    <ListBoxItem Content="{l:T common.myData}"/>
                    <ListBoxItem Content="{l:T settings.llm.models}"/>
                    <ListBoxItem Content="{l:T common.hotkeys}"/>
                    <ListBoxItem Content="{l:T settings.about}"/>
                    <ListBoxItem Content="{l:T common.developer}"/>
                </ListBox>
            </DockPanel>
        </Border>
        
        <!-- 右侧内容区 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30,20">
            <Grid>
                <!-- 常规页面 -->
                <StackPanel x:Name="pageGeneral">
                    <TextBlock Text="{l:T settings.general}" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <!-- 停靠配置（每显示器一个卡片，代码动态生成） -->
                    <StackPanel x:Name="dockConfigContainer"/>

                    <!-- 界面语言 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,16">
                        <DockPanel>
                            <ComboBox x:Name="languageCombo" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Width="140" Height="28"
                                      Style="{StaticResource GlobalComboBoxStyle}"
                                      SelectionChanged="LanguageCombo_Changed">
                                <ComboBoxItem Content="{l:T settings.followSystem}" Tag="auto"/>
                                <ComboBoxItem Content="{l:T settings.simplifiedChinese}" Tag="zh-CN"/>
                                <ComboBoxItem Content="繁體中文" Tag="zh-TW"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="日本語" Tag="ja"/>
                                <ComboBoxItem Content="한국어" Tag="ko"/>
                                <ComboBoxItem Content="Deutsch" Tag="de"/>
                                <ComboBoxItem Content="Español" Tag="es"/>
                                <ComboBoxItem Content="Français" Tag="fr"/>
                                <ComboBoxItem Content="Italiano" Tag="it"/>
                                <ComboBoxItem Content="Polski" Tag="pl"/>
                                <ComboBoxItem Content="Русский" Tag="ru"/>
                                <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/>
                                <ComboBoxItem Content="Türkçe" Tag="tr"/>
                            </ComboBox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T settings.interfaceLanguage}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.languageSwitchHint}"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           TextWrapping="Wrap" Margin="0,2,8,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 虚拟桌面独立配置开关 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="perVirtualDesktopSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="PerVirtualDesktopSwitch_Changed"
                                          Unchecked="PerVirtualDesktopSwitch_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T settings.perVirtualDesktopSettings}"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:T settings.perDesktopHint}"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- 桌面选择器（仅开启时显示） -->
                            <StackPanel x:Name="desktopSelectorPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,12"/>
                                <DockPanel>
                                    <TextBlock Text="{l:T settings.currentlyEditedDesktop}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               DockPanel.Dock="Left"/>
                                    <ComboBox x:Name="desktopSelectorCombo" Width="120"
                                              Style="{StaticResource GlobalComboBoxStyle}"
                                              SelectionChanged="DesktopSelector_Changed"
                                              DockPanel.Dock="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- AI 对话模式（本地化 / 网页版） -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,16">
                        <DockPanel>
                            <ComboBox x:Name="aiChatModeCombo" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Width="140" Height="28"
                                      Style="{StaticResource GlobalComboBoxStyle}"
                                      SelectionChanged="AIChatModeCombo_Changed">
                                <ComboBoxItem Content="{l:T common.local}" Tag="client"/>
                                <ComboBoxItem Content="{l:T common.webVersion}" Tag="web"/>
                                <ComboBoxItem Content="{l:T common.auto}" Tag="auto"/>
                            </ComboBox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T settings.aiChatMode}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.chatModeHint}"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           TextWrapping="Wrap" Margin="0,2,8,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- MCP 工具配置（服务端下载更新） -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,16">
                        <DockPanel>
                            <Button x:Name="downloadMcpConfigBtn" DockPanel.Dock="Right" VerticalAlignment="Center"
                                    Content="{l:T settings.downloadUpdate}" Width="90" MinHeight="28" Padding="8,3"
                                    Style="{StaticResource StandardButtonStyle}"
                                    Cursor="Hand" Click="DownloadMcpConfig_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T system.mcpToolConfig}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="mcpConfigStatusText" Text="{l:T settings.mcpToolNotDownloaded}"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           TextWrapping="Wrap" Margin="0,2,8,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 软件渲染模式（禁用 GPU 硬件加速） -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,16">
                        <DockPanel>
                            <CheckBox x:Name="softwareRenderSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="SoftwareRenderSwitch_Changed"
                                      Unchecked="SoftwareRenderSwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T settings.softwareRenderingMode}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.softwareRenderingHint}"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           TextWrapping="Wrap" Margin="0,2,8,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 显示AI推荐提示窗（全局根级项：不属于任何屏幕/显示器配置） -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,16">
                        <DockPanel>
                            <CheckBox x:Name="floatingContextSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="FloatingContextSwitch_Changed"
                                      Unchecked="FloatingContextSwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T settings.showAiRecommendationPrompt}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.aiPicksHint}"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 账户页面 -->
                <StackPanel x:Name="pageAccount" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="{l:T common.account}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>

                    <!-- 个人资料卡片（含登录状态） -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 个人资料详情（仅登录后显示） -->
                            <StackPanel x:Name="accountProfileSection" Visibility="Collapsed">
                                <TextBlock Text="{l:T settings.profile}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                                <DockPanel>
                                    <!-- 头像（点击更换） -->
                                    <Border Width="64" Height="64" CornerRadius="32"
                                            Background="{DynamicResource BrushAccent}"
                                            DockPanel.Dock="Left" Margin="0,0,16,0"
                                            Cursor="Hand" MouseLeftButtonUp="AccountAvatar_Click"
                                            ToolTip="{l:T settings.clickToChangeAvatar}">
                                        <Grid>
                                            <TextBlock x:Name="accountAvatarFallbackText" Text="?"
                                                       Foreground="White" FontSize="26"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border x:Name="accountAvatarImageHost" CornerRadius="32" Visibility="Collapsed">
                                                <Border.Background>
                                                    <ImageBrush x:Name="accountAvatarImageBrush" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- 昵称编辑 -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{l:T common.nickname}"
                                                   Foreground="{DynamicResource BrushTextMuted}"
                                                   FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6"/>
                                        <!-- 展示态：默认只显示昵称，悬停浮现编辑提示，点击进入编辑 -->
                                        <Border x:Name="nicknameDisplayHost" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"
                                                Padding="8,6" MinHeight="30" Cursor="Hand"
                                                ToolTip="{l:T settings.clickToChangeNickname}"
                                                MouseEnter="NicknameDisplay_MouseEnter"
                                                MouseLeave="NicknameDisplay_MouseLeave"
                                                MouseLeftButtonUp="NicknameDisplay_Click">
                                            <DockPanel>
                                                <TextBlock x:Name="nicknameEditHint" DockPanel.Dock="Right" Text="{l:T common.editEmoji}"
                                                           Visibility="Collapsed" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrushTextMuted}"
                                                           FontSize="{DynamicResource FontSizeSmall}" Margin="8,0,0,0"/>
                                                <TextBlock x:Name="nicknameDisplayText" Text="-"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrushTextMain}"
                                                           FontSize="{DynamicResource FontSizeNormal}"/>
                                            </DockPanel>
                                        </Border>
                                        <!-- 编辑态：点击进入后出现输入框 + 保存按钮 -->
                                        <DockPanel x:Name="nicknameEditHost" Visibility="Collapsed">
                                            <Button x:Name="cancelNicknameBtn" Content="{l:T common.cancel}" DockPanel.Dock="Right"
                                                    Click="CancelNickname_Click"
                                                    Style="{DynamicResource StandardButtonStyle}"
                                                    Padding="14,6" Height="30" Margin="8,0,0,0"/>
                                            <Button x:Name="saveNicknameBtn" Content="{l:T common.save}" DockPanel.Dock="Right"
                                                    Click="SaveNickname_Click"
                                                    Style="{DynamicResource PrimaryButtonStyle}"
                                                    Padding="14,6" Height="30" Margin="8,0,0,0"/>
                                            <TextBox x:Name="nicknameBox"
                                                     Style="{StaticResource GlobalTextBoxStyle}"
                                                     Height="30" VerticalContentAlignment="Center"
                                                     PreviewKeyDown="NicknameBox_PreviewKeyDown"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            </StackPanel>
                            <!-- 登录状态 -->
                            <DockPanel>
                                <Button x:Name="accountActionBtn" DockPanel.Dock="Right" Content="{l:T common.logIn}"
                                        Click="AccountAction_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Padding="16,6" Height="32" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="accountStatusText" Text="{l:T common.notLoggedIn}"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="accountSubText" Text="{l:T settings.logInToEnable}"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 云同步卡片 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="cloudSyncSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="CloudSyncSwitch_Changed"
                                          Unchecked="CloudSyncSwitch_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T common.cloudSync}"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:T settings.autoBackupHint}"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="cloudSyncStatusText" Text="{l:T common.notSyncedYet}"
                                           Foreground="{DynamicResource BrushTextSec}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="syncNowBtn" Grid.Column="1" Content="{l:T settings.syncNow}"
                                        Click="SyncNow_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="14,6" Height="30"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            <!-- 加密同步 -->
                            <DockPanel>
                                <CheckBox x:Name="encryptSyncSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="EncryptSyncSwitch_Changed"
                                          Unchecked="EncryptSyncSwitch_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T common.encryptedSync}"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"/>
                                    <TextBlock Text="{l:T settings.encryptedSyncHint}"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            <!-- 恢复设置 -->
                            <DockPanel>
                                <Button x:Name="restoreSettingsBtn" DockPanel.Dock="Right" Content="{l:T settings.restoreFromCloud}"
                                        Click="RestoreSettings_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="14,6" Height="30"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T settings.restoreSettings}"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeNormal}"/>
                                    <TextBlock Text="{l:T settings.pullSettingsHint}"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 本地备份 / 导出 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T settings.backupExport}"
                                       Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T settings.localBackupHint}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeTiny}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="backupStatusText" Text="{l:T settings.noLocalBackupYet}"
                                           Foreground="{DynamicResource BrushTextSec}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{l:T common.backup}" Click="Backup_Click"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="14,6" Height="30" Margin="0,0,8,0"/>
                                    <Button x:Name="restoreBtn" Content="{l:T common.restore}" Click="Restore_Click"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="14,6" Height="30" Margin="0,0,8,0"/>
                                    <Button Content="{l:T settings.exportConfiguration}" Click="ExportConfig_Click"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="14,6" Height="30"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- 云空间页面 -->
                <StackPanel x:Name="pageCloudSpaces" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="{l:T common.cloudSpace}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{l:T settings.cloudDriveManageHint}"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="cloudSpaceListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:T settings.addCloudSpace}" Click="AddCloudSpace_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="{l:T settings.restoreBuiltIn}" Click="RestoreBuiltinSpaces_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"
                                ToolTip="{l:T settings.restoreMissingBuiltIn}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 团队页面 -->
                <StackPanel x:Name="pageTeams" Visibility="Collapsed" Margin="0,0,0,20">
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{l:T settings.addTeam}" Click="AddTeam_Click"
                                    Style="{StaticResource GhostButtonStyle}" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="{l:T common.joinTeam}" Click="JoinTeam_Click"
                                    Style="{StaticResource GhostButtonStyle}" Padding="12,6"
                                    ToolTip="{l:T settings.enterTeamCodeHint}"/>
                        </StackPanel>
                        <TextBlock Text="{l:T common.team}"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextMain}"/>
                    </DockPanel>
                    <TextBlock Text="{l:T settings.manageYourTeamsAnd}"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="teamListPanel"/>
                    </Border>

                    <!-- 待处理加入申请区（管理员可见） -->
                    <Border x:Name="teamApplySection" Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{l:T settings.pendingJoinRequests}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="teamApplyPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- 我收到的团队邀请区 -->
                    <Border x:Name="teamInviteSection" Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{l:T settings.teamInvitationsReceived}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="teamInvitePanel"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 好友页面 -->
                <StackPanel x:Name="pageFriends" Visibility="Collapsed" Margin="0,0,0,20">
                    <DockPanel Margin="0,0,0,8">
                        <!-- 右上角：添加好友入口，点击展开搜索区 -->
                        <Button x:Name="addFriendBtn" Click="ToggleFriendSearch_Click" DockPanel.Dock="Right"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6" VerticalAlignment="Center">
                            <emoji:TextBlock Text="{l:T settings.addFriendEmoji}"/>
                        </Button>
                        <TextBlock Text="{l:T common.friends}"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextMain}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="friendPageSubtitle" Text="{l:T settings.friendSearchHint}"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,0,16"/>

                    <!-- 搜索添加区（默认隐藏，点右上角「添加好友」展开） -->
                    <Border x:Name="friendSearchSection" Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="friendSearchBtn" Content="{l:T common.search}" DockPanel.Dock="Right"
                                        Style="{StaticResource GhostButtonStyle}" Padding="14,6" Margin="8,0,0,0"
                                        Click="FriendSearch_Click"/>
                                <TextBox x:Name="friendSearchBox"
                                         Style="{StaticResource GlobalTextBoxStyle}"
                                         KeyDown="FriendSearchBox_KeyDown"/>
                            </DockPanel>
                            <StackPanel x:Name="friendSearchResultPanel" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 好友请求区 -->
                    <Border x:Name="friendRequestSection" Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{l:T common.friendRequest}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="friendRequestPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- 好友列表区 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{l:T settings.myFriends}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="friendListPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- 允许被搜索添加好友 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12">
                        <DockPanel>
                            <CheckBox x:Name="allowFriendSearchSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="AllowFriendSearch_Changed"
                                      Unchecked="AllowFriendSearch_Changed"/>
                            <StackPanel>
                                <TextBlock Text="{l:T settings.allowOthersToFind}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextMain}"/>
                                <TextBlock Text="{l:T settings.friendCodeDisableWarning}"
                                           FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 我的好友码 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,12,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="refreshFriendCodeBtn" Content="{l:T common.swap}"
                                        Style="{StaticResource GhostButtonStyle}" Padding="14,6" Margin="8,0,0,0"
                                        Click="RefreshFriendCode_Click"/>
                                <Button x:Name="copyFriendCodeBtn" Content="{l:T common.copy}"
                                        Style="{StaticResource GhostButtonStyle}" Padding="14,6" Margin="8,0,0,0"
                                        Click="CopyFriendCode_Click"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T settings.myFriendCode}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextMain}"/>
                                <TextBlock x:Name="myFriendCodeText" Text="{l:T common.loading}"
                                           FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{DynamicResource BrushAccent}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 外观页面 -->
                <StackPanel x:Name="pageAppearance" Visibility="Collapsed">
                    <TextBlock Text="{l:T common.appearance}" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <!-- 主题模式 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{l:T common.themeMode}" Foreground="{DynamicResource BrushTextMain}" 
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="{l:T settings.colorThemeHint}" Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="themeModeCombo" Grid.Column="1" Width="120"
                                  Style="{StaticResource GlobalComboBoxStyle}"
                                  SelectionChanged="ThemeMode_Changed"/>
                    </Grid>

                    <!-- 配色主题（JSON 自定义主题） -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{l:T settings.colorTheme}" Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="{l:T settings.customThemesNote}" Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="customThemeCombo" Grid.Column="1" Width="160"
                                  Style="{StaticResource GlobalComboBoxStyle}"
                                  SelectionChanged="CustomTheme_Changed"/>
                    </Grid>

                    <!-- 背景透明度 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{l:T common.backgroundOpacity}" Foreground="{DynamicResource BrushTextMain}" 
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="{l:T settings.panelOpacityHint}" Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="bgOpacityBox" Width="70"
                                     Style="{StaticResource GlobalTextBoxStyle}"
                                     TextAlignment="Center"
                                     LostFocus="BgOpacity_LostFocus"
                                     KeyDown="BgOpacity_KeyDown"/>
                            <TextBlock Text="%" Foreground="{DynamicResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 隐藏模块外框时同时隐藏标题 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{l:T settings.alsoHideTheModule}" Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="{l:T settings.hideTitleWithFrameHint}" Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="hideModuleTitleSwitch" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource RaycastSwitchStyle}"
                                  Checked="HideModuleTitleSwitch_Changed"
                                  Unchecked="HideModuleTitleSwitch_Changed"/>
                    </Grid>

                    <!-- 显示通知条 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{l:T settings.showNotificationBar}" Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="{l:T settings.notificationBarHint}" Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="showNotificationStripSwitch" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource RaycastSwitchStyle}"
                                  Checked="ShowNotificationStripSwitch_Changed"
                                  Unchecked="ShowNotificationStripSwitch_Changed"/>
                    </Grid>

                    <!-- 分享组件边框颜色 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{l:T settings.sharedComponentBorderColor}" Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="{l:T settings.shareImportColorHint}" Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <WrapPanel x:Name="shareBorderSwatches"/>
                            <TextBox x:Name="shareBorderHexBox" Width="90" Margin="0,6,0,0" HorizontalAlignment="Right"
                                     Style="{StaticResource GlobalTextBoxStyle}"
                                     Tag="share"
                                     LostFocus="BorderHex_LostFocus"
                                     KeyDown="BorderHex_KeyDown"/>
                        </StackPanel>
                    </Grid>

                    <!-- 团队组件边框颜色 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{l:T settings.teamComponentBorderColor}" Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text="{l:T settings.teamOwnerColorHint}" Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <WrapPanel x:Name="teamBorderSwatches"/>
                            <TextBox x:Name="teamBorderHexBox" Width="90" Margin="0,6,0,0" HorizontalAlignment="Right"
                                     Style="{StaticResource GlobalTextBoxStyle}"
                                     Tag="team"
                                     LostFocus="BorderHex_LostFocus"
                                     KeyDown="BorderHex_KeyDown"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                
                <!-- 程序管理页面 -->
                <StackPanel x:Name="pageProgramManager" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="{l:T settings.programManagement}" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <!-- 系统安装应用（来自 Windows 已安装程序列表，本地缓存避免每次打开设置重新拉取） -->
                    <TextBlock Text="{l:T settings.installedApps}" 
                               FontSize="{DynamicResource FontSizeNormal}" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{l:T settings.installedAppsHint}" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,12"/>
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="6" 
                            Padding="6" Margin="0,0,0,24"
                            SizeChanged="InstalledAppsBorder_SizeChanged">
                        <WrapPanel x:Name="installedAppsPanel"/>
                    </Border>

                    <!-- 已注册程序 -->
                    <TextBlock Text="{l:T settings.registeredPrograms}" 
                               FontSize="{DynamicResource FontSizeNormal}" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{l:T settings.programListHint}" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,12"/>
                    
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="6" 
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="programListPanel"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button Content="{l:T settings.addProgramButton}" Click="AddProgram_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>
                    
                    <!-- 浏览器配置 -->
                    <TextBlock Text="{l:T common.browserConfiguration}" 
                               FontSize="{DynamicResource FontSizeNormal}" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{l:T settings.browserConfigHint}" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,12"/>
                    
                    <!-- 默认 Profile 目录 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{l:T settings.defaultProfileDirectory}" Foreground="{DynamicResource BrushTextMain}" 
                                       FontSize="{DynamicResource FontSizeNormal}"/>
                            <TextBlock Text=" ℹ" FontSize="13" Foreground="{DynamicResource BrushAccent}" 
                                       VerticalAlignment="Center" Cursor="Help"
                                       ToolTip="{l:T settings.profileAutoCreateHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="profileBaseDirText" 
                                       Text="{l:T common.notSet}" 
                                       Foreground="{DynamicResource BrushTextMuted}" 
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       VerticalAlignment="Center"
                                       MaxWidth="200" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,8,0"/>
                            <Button Content="{l:T common.select}" Click="SelectProfileBaseDir_Click"
                                    Style="{StaticResource GhostButtonStyle}" Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel x:Name="browserListPanel"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{l:T settings.addBrowser}" Click="AddBrowser_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 插件管理页面 -->
                <StackPanel x:Name="pagePlugins" Visibility="Collapsed" Margin="0,0,0,20">
                    <DockPanel Margin="0,0,0,8">
                        <!-- 右上角：插件市场入口 -->
                        <Button Click="OpenPluginMarket_Click" DockPanel.Dock="Right"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6" VerticalAlignment="Center">
                            <emoji:TextBlock Text="{l:T market.pluginMarketEmoji}"/>
                        </Button>
                        <TextBlock Text="{l:T common.plugins}" 
                                   FontSize="{DynamicResource FontSizeSubtitle}" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextMain}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{l:T settings.pluginManageHint}" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,16"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="{l:T settings.refreshList}" Click="RefreshPluginList_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                        <Button Click="ImportPlugin_Click" Margin="8,0,0,0"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"
                                ToolTip="{l:T settings.importLocalZipHint}">
                            <emoji:TextBlock Text="{l:T settings.importPlugin}"/>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="pluginListPanel"/>
                </StackPanel>
                
                <!-- 工具页面 -->
                <StackPanel x:Name="pageTools" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="{l:T common.tools}" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{l:T settings.builtInUtilities}" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,20"/>
                    
                    <!-- 任务栏标题锁定 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{l:T settings.setUpNow}" Click="TaskbarOverlayButton_Click"
                                        Style="{StaticResource GhostButtonStyle}" 
                                        Padding="10,6" Margin="0,0,12,0"/>
                                <CheckBox x:Name="titleLockSwitch" 
                                          Style="{StaticResource RaycastSwitchStyle}"
                                          Checked="TitleLockSwitch_Changed" 
                                          Unchecked="TitleLockSwitch_Changed"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T common.taskbarTitleLock}" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.titleLockHint}" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- MCP 服务器 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="mcpServerSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="McpServerSwitch_Changed" 
                                      Unchecked="McpServerSwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T settings.mcpServer}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.mcpEndpointHint}"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- HTTP 服务器 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="httpServerSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="HttpServerSwitch_Changed" 
                                      Unchecked="HttpServerSwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T settings.httpServer}" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.httpServerHint}" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{l:T settings.port}" Foreground="{DynamicResource BrushTextSec}" 
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="httpPortBox" Width="70" FontSize="12" Padding="4,3"
                                             Text="19195" LostFocus="HttpPort_LostFocus" KeyDown="HttpPort_KeyDown"/>
                                    <TextBlock x:Name="httpServerStatusText" Text="" 
                                               Foreground="{DynamicResource BrushTextMuted}" 
                                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 窗口使用时长统计 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="usageStatsSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="UsageStatsSwitch_Changed"
                                      Unchecked="UsageStatsSwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T settings.windowUsageStatistics}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.usageTrackingHint}"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 开机自启动 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="autoStartSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="AutoStartSwitch_Changed"
                                      Unchecked="AutoStartSwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T settings.runAtStartup}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.automaticallyRunSidedeskAfter}"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
                
                <!-- 模块页面 -->
                <StackPanel x:Name="pageModules" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="{l:T common.module}" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{l:T settings.moduleConfigHint}" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,20"/>
                    
                    <!-- 数据模块连接方式 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{l:T settings.webDataSourceMode}" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"/>
                                <TextBlock Text=" ❓" FontSize="12" Cursor="Help" VerticalAlignment="Center"
                                           ToolTip="{l:T settings.webFetchModeHint}"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                            </StackPanel>
                            <RadioButton x:Name="rbModeExtension" Content="{l:T settings.browserExtensionMode}" GroupName="DataFetchMode"
                                         Foreground="{DynamicResource BrushTextMain}" FontSize="13"
                                         Margin="0,0,0,6" Checked="DataFetchMode_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="rbModeCdp" Content="{l:T settings.cdpConnectionMode}" GroupName="DataFetchMode"
                                             Foreground="{DynamicResource BrushTextMain}" FontSize="13"
                                             VerticalAlignment="Center" Checked="DataFetchMode_Changed"/>
                                <Button Content="{l:T settings.testConnection}" Click="TestCdpConnection_Click"
                                        Style="{StaticResource GhostButtonStyle}" Padding="8,3"
                                        FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- CDP 端口配置（仅 CDP 模式显示） -->
                            <StackPanel x:Name="cdpPortSection" Orientation="Horizontal" Visibility="Collapsed" Margin="20,0,0,0">
                                <TextBlock Text="{l:T settings.debugPort}" Foreground="{DynamicResource BrushTextSec}" 
                                           FontSize="12" VerticalAlignment="Center"/>
                                <TextBox x:Name="cdpPortBox" Width="70" FontSize="12" Padding="4,3"
                                         Text="9222" LostFocus="CdpPort_LostFocus"/>
                                <TextBlock Text="{l:T settings.remoteDebuggingPortNote}" 
                                           Foreground="{DynamicResource BrushTextMuted}" 
                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <!-- 隐藏浏览器启动模式（仅 CDP 模式显示） -->
                            <StackPanel x:Name="hiddenBrowserSection" Orientation="Horizontal" Visibility="Collapsed" Margin="20,8,0,0">
                                <TextBlock Text="{l:T settings.hiddenBrowser}" Foreground="{DynamicResource BrushTextSec}" 
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="hiddenBrowserModeCombo" Width="90" FontSize="11"
                                          SelectionChanged="HiddenBrowserMode_Changed">
                                    <ComboBoxItem Content="{l:T settings.headlessMode}" Tag="headless"/>
                                    <ComboBoxItem Content="{l:T common.hiddenWindow}" Tag="hidden"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                                        
                    <!-- 数据模版 -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{l:T data.myTemplates}"
                                   FontSize="{DynamicResource FontSizeNormal}" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextMain}"/>
                        <TextBlock Text="{l:T data.myTemplatesHint}" 
                                   Foreground="{DynamicResource BrushTextMuted}" 
                                   FontSize="{DynamicResource FontSizeSmall}" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="6" 
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel x:Name="templateListPanel"/>
                    </Border>
                    <Grid Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="{l:T settings.newTemplate}" Click="AddTemplate_Click"
                                    Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                            <Button Content="{l:T settings.importFromDashboard}" Click="ImportFromDashboard_Click"
                                    Style="{StaticResource GhostButtonStyle}" Padding="12,6" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Button Content="{l:T market.dataTemplateMarket}" Click="OpenDataTemplateMarket_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,6"
                                HorizontalAlignment="Right"
                                ToolTip="{l:T market.openTemplateMarketHint}"/>
                    </Grid>
                </StackPanel>
                
                <!-- 我的数据页面 -->
                <StackPanel x:Name="pageMyData" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="{l:T common.myData}" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{l:T settings.myDataOverview}" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,20"/>
                    <UniformGrid x:Name="myDataCardsGrid" Columns="2"/>
                    <!-- 数据模块入口（原「模块」页的我的数据看板） -->
                    <Button Click="OpenDashboardList_Click" Margin="6,12,6,0"
                            Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                            HorizontalAlignment="Left"
                            ToolTip="{l:T settings.dashboardWindowHint}">
                        <emoji:TextBlock Text="{l:T settings.viewDashboards}"/>
                    </Button>
                </StackPanel>

                <!-- 快捷键页面 -->
                <StackPanel x:Name="pageShortcuts" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="{l:T common.hotkeys}" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{l:T settings.globalHotkeyConfiguration}" 
                               Foreground="{DynamicResource BrushTextMuted}" 
                               FontSize="{DynamicResource FontSizeSmall}" 
                               Margin="0,0,0,20"/>

                    <!-- Ctrl + 数字 切换窗口 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="windowSwitchHotkeySwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="WindowSwitchHotkeySwitch_Changed" 
                                      Unchecked="WindowSwitchHotkeySwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T settings.ctrlNumberToSwitch}" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.windowTabHotkeyHint}" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{l:T settings.hotkeyInterceptNote}" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 语音输入快捷键（启动识别 / 停止并粘贴到当前焦点） -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Padding="16" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="voiceInputHotkeySwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource RaycastSwitchStyle}"
                                      Checked="VoiceInputHotkeySwitch_Changed" 
                                      Unchecked="VoiceInputHotkeySwitch_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T settings.aiVoiceInputHotkeys}" 
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T settings.voiceHotkeyHint}" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T settings.startVoice}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextMain}"/>
                                    <TextBox x:Name="voiceStartHotkeyBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="8,0,0,0"
                                             PreviewKeyDown="VoiceHotkeyBox_PreviewKeyDown"
                                             GotFocus="VoiceHotkeyBox_GotFocus" LostFocus="VoiceHotkeyBox_LostFocus"
                                             ToolTip="{l:T settings.hotkeyEditHint}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T settings.stopVoice}" VerticalAlignment="Center" Margin="0,8,0,0"
                                               Foreground="{DynamicResource BrushTextMain}"/>
                                    <TextBox x:Name="voiceStopHotkeyBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="8,8,0,0"
                                             PreviewKeyDown="VoiceHotkeyBox_PreviewKeyDown"
                                             GotFocus="VoiceHotkeyBox_GotFocus" LostFocus="VoiceHotkeyBox_LostFocus"
                                             ToolTip="{l:T settings.hotkeyEditHint}"/>
                                </Grid>
                                <TextBlock Text="{l:T settings.voiceHotkeyInterceptNote}"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 小屏窗口管理页面 -->
                <StackPanel x:Name="pageWindows" Visibility="Collapsed">
                    <TextBlock Text="{l:T common.screenWindow}" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>

                    <!-- 操作按钮栏 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="{l:T common.importWindow}" Style="{StaticResource GhostButtonStyle}" 
                                Padding="12,6" Click="ImportWindow_Click" Margin="0,0,8,0"/>
                        <Button Content="{l:T settings.mySharesEmoji}" Style="{StaticResource GhostButtonStyle}" 
                                Padding="12,6" Click="MyShares_Click"/>
                    </StackPanel>

                    <!-- 窗口列表（代码动态生成） -->
                    <StackPanel x:Name="windowListPanel"/>
                </StackPanel>

                <!-- 关于页面 -->
                <StackPanel x:Name="pageAbout" Visibility="Collapsed">
                    <TextBlock Text="{l:T settings.about}" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <TextBlock Text="{l:T common.metadeskScreen}" 
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="versionText" 
                               Foreground="{DynamicResource BrushTextSec}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="fileVersionText" 
                               Foreground="{DynamicResource BrushTextSec}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="{l:T settings.appDescription}" 
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <!-- 自动更新区域 -->
                    <Border Background="{DynamicResource BrushBG}" CornerRadius="8" 
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 自动更新开关 -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{l:T settings.automaticallyCheckAndDownload}" 
                                           Foreground="{DynamicResource BrushTextMain}" 
                                           FontSize="{DynamicResource FontSizeNormal}" 
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="autoUpdateSwitch" HorizontalAlignment="Right" 
                                          Style="{DynamicResource RaycastSwitchStyle}" 
                                          Click="AutoUpdateSwitch_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,12"/>

                            <!-- 检查更新按钮 + 状态文字 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="updateStatusText" Text="{l:T settings.checkUpdateAction}" 
                                           Foreground="{DynamicResource BrushTextSec}" 
                                           FontSize="{DynamicResource FontSizeNormal}" 
                                           VerticalAlignment="Center"/>
                                <Button x:Name="checkUpdateBtn" Grid.Column="1" Content="{l:T common.checkForUpdates}" 
                                        Click="CheckForUpdates_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Padding="14,6" Height="30"/>
                            </Grid>

                            <!-- 下载进度条（初始隐藏） -->
                            <StackPanel x:Name="downloadProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{l:T settings.downloadingUpdate}" 
                                               Foreground="{DynamicResource BrushTextMain}" 
                                               FontSize="{DynamicResource FontSizeNormal}"/>
                                    <TextBlock x:Name="progressPercentText" Text="0%" 
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource BrushAccent}" 
                                               FontSize="{DynamicResource FontSizeNormal}" 
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <ProgressBar x:Name="downloadProgressBar" Value="0" 
                                             Height="6" Minimum="0" Maximum="100" 
                                             BorderThickness="0" 
                                             Background="{DynamicResource BrushInputBG}" 
                                             Foreground="{DynamicResource BrushAccent}"/>
                            </StackPanel>

                            <!-- 应用更新并重启按钮（初始隐藏） -->
                            <Grid x:Name="applyUpdatePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:T settings.newVersionReadyRestart}" 
                                           Foreground="#FF22C55E" 
                                           FontSize="{DynamicResource FontSizeNormal}" 
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{l:T settings.restartNowAndApply}" 
                                        Click="ApplyUpdateAndRestart_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Padding="14,6" Height="30"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 开发者页面 -->
                <StackPanel x:Name="pageDeveloper" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="{l:T common.developer}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{l:T settings.debugTestTools}"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,0,20"/>

                    <!-- API 密钥 -->
                    <Border Background="{DynamicResource BrushInputBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{l:T settings.apiKey.title}"
                                       Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T settings.apiKey.introHint}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeTiny}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{l:T settings.apiKey.localApiHint}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeTiny}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>

                            <!-- 未登录提示 -->
                            <TextBlock x:Name="apiKeyLoginHint" Text="{l:T settings.apiKey.loginRequired}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeTiny}"
                                       Visibility="Collapsed" Margin="0,10,0,0"/>

                            <!-- 创建：点击后弹对话框输入名称（备注用） -->
                            <StackPanel x:Name="apiKeyCreateRow" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="apiKeyCreateBtn" Content="{l:T settings.apiKey.addKeyPlus}" Click="ApiKeyCreate_Click"
                                        Style="{StaticResource GhostButtonStyle}" Padding="12,6"
                                        Cursor="Hand"/>
                            </StackPanel>

                            <!-- 创建结果：完整密钥仅显示这一次 -->
                            <Border x:Name="apiKeyResultBox" Visibility="Collapsed"
                                    Background="{DynamicResource BrushBG}" BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T settings.apiKey.createdShowOnce}"
                                               Foreground="{DynamicResource BrushAccent}" FontSize="11" FontWeight="SemiBold"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <Button x:Name="apiKeyCopyBtn" DockPanel.Dock="Right" Content="{l:T common.copy}"
                                                Style="{StaticResource GhostButtonStyle}" Padding="10,4"
                                                Margin="8,0,0,0" Click="ApiKeyCopy_Click" Cursor="Hand"/>
                                        <TextBox x:Name="apiKeyResultText" IsReadOnly="True" FontFamily="Consolas"
                                                 Style="{StaticResource GlobalTextBoxStyle}" FontSize="12" Padding="4,3"/>
                                    </DockPanel>
                                    <TextBlock Text="{l:T settings.apiKey.callExample}"
                                               Foreground="{DynamicResource BrushTextMuted}" FontSize="10"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 密钥列表（代码动态构建） -->
                            <StackPanel x:Name="apiKeyListBox" Margin="0,12,0,0"/>
                            <TextBlock x:Name="apiKeyEmptyText" Text="{l:T settings.apiKey.noKeysHint}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeTiny}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 隐藏测试面板宿主：连按 10 次 F12 后填充并显示 -->
                    <StackPanel x:Name="devTestHost" Visibility="Collapsed"/>
                </StackPanel>

                <!-- 大模型页面（内容由代码动态构建，见 SettingsWindow.LlmKeys.cs） -->
                <StackPanel x:Name="pageLlmKeys" Visibility="Collapsed" Margin="0,0,0,20"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
