<Window x:Class="SideDesk.TitleLockPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口标题锁定" Height="540" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：已锁定窗口列表 -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="已锁定窗口列表" FontWeight="Bold"
                       FontSize="{DynamicResource FontSizeNormal}"
                       Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button x:Name="editRuleBtn" Content="编辑规则" Style="{StaticResource GhostButtonStyle}"
                        Padding="10,6" Margin="0,0,8,0" Click="EditRuleBtn_Click"/>
                <Button x:Name="deleteRuleBtn" Content="删除规则" Style="{StaticResource GhostButtonStyle}"
                        Padding="10,6" Margin="0,0,8,0" Click="DeleteRuleBtn_Click"/>
                <Button x:Name="refreshLockedBtn" Content="刷新" Style="{StaticResource GhostButtonStyle}"
                        Padding="10,6" Click="RefreshLockedBtn_Click"/>
            </StackPanel>
            <ListBox x:Name="lockedListBox" Background="{DynamicResource BrushInputBG}"
                     Foreground="{DynamicResource BrushTextMain}" BorderBrush="{DynamicResource BrushBorder}"
                     Margin="0,0,0,8" MouseDoubleClick="LockedListBox_MouseDoubleClick"/>
        </DockPanel>

        <!-- 右侧：可选窗口 -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="选择一个窗口来锁定标题" FontWeight="Bold"
                       FontSize="{DynamicResource FontSizeNormal}"
                       Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" Style="{StaticResource StandardButtonStyle}"
                        Padding="16,8" Margin="0,0,10,0" Click="CancelBtn_Click"/>
                <Button Content="下一步" Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,8" Click="NextBtn_Click"/>
            </StackPanel>
            <ListBox x:Name="windowListBox" Background="{DynamicResource BrushInputBG}"
                     Foreground="{DynamicResource BrushTextMain}" BorderBrush="{DynamicResource BrushBorder}"
                     Margin="0,0,0,8" MouseDoubleClick="WindowListBox_MouseDoubleClick"/>
        </DockPanel>
    </Grid>
</Window>
