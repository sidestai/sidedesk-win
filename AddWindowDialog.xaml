<Window x:Class="SideDesk.AddWindowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加窗口" Height="240" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="添加窗口" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                   Foreground="{DynamicResource BrushTextMain}" Margin="0,0,0,14"/>

        <!-- 内容面板 -->
        <StackPanel Grid.Row="1">
            <!-- 名称 -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="名称：" Width="60" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                <TextBox x:Name="nameBox" Text="新窗口" Style="{StaticResource GlobalTextBoxStyle}"/>
            </DockPanel>

            <!-- 模式选择 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="模式：" Width="60" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                <RadioButton x:Name="nativeRadio" Content="Native" IsChecked="True" 
                             FontSize="{DynamicResource FontSizeNormal}"
                             Foreground="{DynamicResource BrushTextSec}" Margin="0,0,15,0" Checked="ModeChanged"/>
                <RadioButton x:Name="webviewRadio" Content="WebView" 
                             FontSize="{DynamicResource FontSizeNormal}"
                             Foreground="{DynamicResource BrushTextSec}" Checked="ModeChanged"/>
            </StackPanel>

            <!-- URL -->
            <DockPanel Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Left" Text="URL：" Width="60" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                <TextBox x:Name="urlBox" IsEnabled="False" Text="https://" Style="{StaticResource GlobalTextBoxStyle}"/>
            </DockPanel>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="75" Margin="0,0,10,0" Click="OkButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="取消" Width="75" Click="CancelButton_Click"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
