<Window x:Class="SideDesk.WsClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        Title="{l:T 'WebSocket 连接客户端'}" Height="500" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBG}"
        Foreground="{DynamicResource BrushTextMain}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{l:T 'WebSocket 连接客户端'}" 
                       FontSize="{DynamicResource FontSizeSubtitle}" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource BrushTextMain}"
                       VerticalAlignment="Center"/>
            <Button x:Name="refreshBtn" Content="{l:T 刷新}" DockPanel.Dock="Right"
                    Style="{StaticResource GhostButtonStyle}" Padding="12,6"
                    Click="Refresh_Click" Margin="8,0,0,0"/>
            <TextBlock x:Name="countText" Text="" DockPanel.Dock="Right"
                       Foreground="{DynamicResource BrushTextMuted}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>

        <!-- 客户端列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="clientListPanel"/>
        </ScrollViewer>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="2" Text="{l:T 提示：未关联数据看板的页面可点击「关闭标签」手动关闭}"
                   Foreground="{DynamicResource BrushTextMuted}"
                   FontSize="{DynamicResource FontSizeTiny}"
                   Margin="0,8,0,0"/>
    </Grid>
</Window>
