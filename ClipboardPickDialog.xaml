<Window x:Class="SideDesk.ClipboardPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        Title="{l:T clipboard.favoriteClipboardContent}" Height="440" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <DockPanel Margin="18">
        <!-- 标题 + 全选 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <CheckBox x:Name="selectAllCheck" DockPanel.Dock="Right" Content="{l:T clipboard.selectAll}"
                      Click="SelectAll_Click" VerticalAlignment="Center"
                      Foreground="{DynamicResource BrushTextSec}"/>
            <TextBlock Text="{l:T clipboard.selectContentToFavorite}" FontWeight="Bold"
                       FontSize="{DynamicResource FontSizeSubtitle}"
                       Foreground="{DynamicResource BrushTextMain}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:T common.add}" Width="75" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="{l:T common.cancel}" Width="75" Click="Cancel_Click" IsCancel="True"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>

        <!-- 候选列表 -->
        <Border CornerRadius="6" Background="{DynamicResource BrushInputBG}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="listPanel"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
