<Window x:Class="SideDesk.ExtensionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建扩展" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBG}"
        Foreground="{DynamicResource BrushTextMain}">
    <DockPanel>
        <!-- 底部操作栏 -->
        <Border DockPanel.Dock="Bottom" 
                Background="{DynamicResource BrushInputBG}" 
                BorderBrush="{DynamicResource BrushBorder}" 
                BorderThickness="0,1,0,0" 
                Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="btnTestRun" Content="试运行" 
                            Style="{StaticResource GhostButtonStyle}" 
                            Padding="16,8" Margin="0,0,10,0" Click="TestRun_Click"/>
                    <Button x:Name="btnSave" Content="保存并添加" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Padding="16,8" Click="Save_Click"/>
                </StackPanel>
                <TextBlock Text="通过表单创建扩展。" 
                           Foreground="{DynamicResource BrushTextMuted}" 
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeSmall}"/>
            </DockPanel>
        </Border>
        
        <!-- 主体区域 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧主区域 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="30,24">
                <StackPanel>
                    <!-- 标题 -->
                    <TextBlock Text="新建扩展" 
                               FontSize="{DynamicResource FontSizeTitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,24"/>
                    
                    <!-- 类型选择区 -->
                    <TextBlock Text="这个扩展要做什么？" 
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMain}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="选一个最匹配的类型，下面的表单会跟着变。" 
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,0,16"/>
                    
                    <!-- 类型卡片 2x2 -->
                    <UniformGrid Rows="2" Columns="2" Margin="0,0,0,24">
                        <Border x:Name="cardOpen" Margin="0,0,8,8" Padding="16" CornerRadius="8" Cursor="Hand"
                                Background="{DynamicResource BrushInputBG}" 
                                BorderBrush="{DynamicResource BrushAccent}" BorderThickness="2"
                                MouseLeftButtonDown="Card_Click" Tag="open">
                            <StackPanel>
                                <TextBlock Text="⊙" FontSize="24" Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,8"/>
                                <TextBlock Text="打开网址 / 程序" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMain}"/>
                                <TextBlock Text="打开链接、文件、文件夹路径或系统协议" 
                                           Foreground="{DynamicResource BrushTextMuted}" FontSize="{DynamicResource FontSizeTiny}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="cardPaste" Margin="8,0,0,8" Padding="16" CornerRadius="8" Cursor="Hand"
                                Background="{DynamicResource BrushInputBG}" 
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                MouseLeftButtonDown="Card_Click" Tag="paste">
                            <StackPanel>
                                <TextBlock Text="📋" FontSize="24" Margin="0,0,0,8"/>
                                <TextBlock Text="粘贴文本" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMain}"/>
                                <TextBlock Text="向当前光标处粘贴一段固定内容" 
                                           Foreground="{DynamicResource BrushTextMuted}" FontSize="{DynamicResource FontSizeTiny}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="cardPowerShell" Margin="0,8,8,0" Padding="16" CornerRadius="8" Cursor="Hand"
                                Background="{DynamicResource BrushInputBG}" 
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                MouseLeftButtonDown="Card_Click" Tag="powershell">
                            <StackPanel>
                                <TextBlock Text="▶" FontSize="24" Foreground="#E91E63" Margin="0,0,0,8"/>
                                <TextBlock Text="PowerShell 脚本" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMain}"/>
                                <TextBlock Text="跑一段 PowerShell，处理输入和输出" 
                                           Foreground="{DynamicResource BrushTextMuted}" FontSize="{DynamicResource FontSizeTiny}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="cardCSharp" Margin="8,8,0,0" Padding="16" CornerRadius="8" Cursor="Hand"
                                Background="{DynamicResource BrushInputBG}" 
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                MouseLeftButtonDown="Card_Click" Tag="csharp">
                            <StackPanel>
                                <TextBlock Text="&lt;/&gt;" FontSize="24" Foreground="#4CAF50" Margin="0,0,0,8"/>
                                <TextBlock Text="C# 脚本" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMain}"/>
                                <TextBlock Text="复杂逻辑、独立窗口、应用级工具" 
                                           Foreground="{DynamicResource BrushTextMuted}" FontSize="{DynamicResource FontSizeTiny}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    
                    <!-- 动态表单区域 -->
                    <Border Background="{DynamicResource BrushInputBG}" 
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel x:Name="formArea">
                            <!-- 由 code-behind 动态填充 -->
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 右侧预览面板 -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource BrushInputBG}" 
                    BorderBrush="{DynamicResource BrushBorder}" 
                    BorderThickness="1,0,0,0"
                    Padding="20,24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 实时预览标题 -->
                        <TextBlock Text="实时预览" 
                                   FontSize="{DynamicResource FontSizeNormal}" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSec}"
                                   Margin="0,0,0,12"/>
                        
                        <!-- 预览卡片 -->
                        <Border x:Name="previewCard" CornerRadius="8" Padding="16" Margin="0,0,0,20"
                                Background="{DynamicResource BrushBG}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="previewName" Text="未命名扩展" 
                                           FontWeight="Bold" FontSize="{DynamicResource FontSizeNormal}"
                                           Foreground="{DynamicResource BrushTextMain}"/>
                                <TextBlock x:Name="previewDesc" Text="" 
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- 基础信息 -->
                        <TextBlock Text="基础信息" 
                                   FontSize="{DynamicResource FontSizeSmall}" 
                                   Foreground="{DynamicResource BrushTextSec}"
                                   Margin="0,0,0,8"/>
                        
                        <TextBlock Text="名称" Foreground="{DynamicResource BrushTextMuted}" 
                                   FontSize="{DynamicResource FontSizeTiny}" Margin="0,0,0,4"/>
                        <TextBox x:Name="nameBox" Style="{StaticResource GlobalTextBoxStyle}" 
                                 TextChanged="NameBox_TextChanged"/>
                        
                        <TextBlock Text="描述" Foreground="{DynamicResource BrushTextMuted}" 
                                   FontSize="{DynamicResource FontSizeTiny}" Margin="0,12,0,4"/>
                        <TextBox x:Name="descBox" Style="{StaticResource GlobalTextBoxStyle}" 
                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 TextChanged="DescBox_TextChanged"/>
                        
                        <!-- 外观 -->
                        <TextBlock Text="外观" 
                                   FontSize="{DynamicResource FontSizeSmall}" 
                                   Foreground="{DynamicResource BrushTextSec}"
                                   Margin="0,20,0,8"/>
                        
                        <TextBlock Text="主题色" Foreground="{DynamicResource BrushTextMuted}" 
                                   FontSize="{DynamicResource FontSizeTiny}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="colorPalette" Margin="0,0,0,8"/>
                        <TextBox x:Name="colorHexBox" Style="{StaticResource GlobalTextBoxStyle}" 
                                 Text="#3B82F6" TextChanged="ColorHex_TextChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
