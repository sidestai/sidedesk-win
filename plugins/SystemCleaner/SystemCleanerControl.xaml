<UserControl x:Class="SystemCleaner.SystemCleanerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SideDesk.Framework;assembly=SideDesk"
             FontFamily="Microsoft YaHei UI" FontSize="12">
    <StackPanel Margin="6">
        <!-- 内存信息 -->
        <Border x:Name="memoryCard" Background="#22FFFFFF" CornerRadius="6" Padding="8" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock x:Name="txtMemTitle" Text="{l:T systemCleaner.memoryTitle}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T systemCleaner.totalMemoryLabel}" Margin="0,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtTotalMemory" Text="--" Margin="0,1"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T systemCleaner.usedMemoryLabel}" Margin="0,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtUsedMemory" Text="--" Margin="0,1"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:T systemCleaner.availableMemoryLabel}" Margin="0,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtAvailMemory" Text="--" Margin="0,1"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:T systemCleaner.usageRateLabel}" Margin="0,1"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtMemoryPercent" Text="--" FontWeight="Bold" Margin="0,1"/>
                </Grid>
                <!-- 内存进度条 -->
                <ProgressBar x:Name="memoryBar" Height="8" Minimum="0" Maximum="100" Value="0"
                             Margin="0,4,0,0" Foreground="#4FC3F7" Background="#33FFFFFF"/>
            </StackPanel>
        </Border>

        <!-- CPU 信息 -->
        <Border x:Name="cpuCard" Background="#22FFFFFF" CornerRadius="6" Padding="8" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock x:Name="txtCpuTitle" Text="⚙ CPU" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T systemCleaner.usageRateLabel}" Margin="0,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtCpuPercent" Text="--" FontWeight="Bold" Margin="0,1"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T systemCleaner.coreCountLabel}" Margin="0,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtCpuCores" Text="--" Margin="0,1"/>
                </Grid>
                <!-- CPU 进度条 -->
                <ProgressBar x:Name="cpuBar" Height="8" Minimum="0" Maximum="100" Value="0"
                             Margin="0,4,0,0" Foreground="#81C784" Background="#33FFFFFF"/>
            </StackPanel>
        </Border>

        <!-- 清理按钮 -->
        <Button x:Name="btnCleanMemory" Content="{l:T systemCleaner.cleanMemoryButton}" Height="32" Cursor="Hand"
                Background="#4CAF50" Foreground="White" FontWeight="Bold"
                BorderThickness="0" Click="BtnCleanMemory_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="12,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#66BB6A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#388E3C"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- 清理结果提示 -->
        <TextBlock x:Name="txtCleanResult" Text="" Margin="0,4,0,0" FontSize="11"
                   TextWrapping="Wrap" Foreground="#A5D6A7"/>
    </StackPanel>
</UserControl>
