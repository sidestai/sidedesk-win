<UserControl x:Class="SideDesk.Controls.FloatingContextPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SideDesk.Framework"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             Focusable="False">
    <Border x:Name="rootBorder"
            Background="{DynamicResource BrushInputBG}"
            BorderBrush="{DynamicResource BrushAccent}"
            BorderThickness="1" CornerRadius="8"
            Margin="1,4">
        <DockPanel Margin="8,6">
            <!-- 头部：标题（AI推荐） + 关闭按钮 -->
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="titleText" Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextMuted}"
                           FontSize="{DynamicResource FontSizeTiny}"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="closeBtn" Grid.Column="1" Content="✕"
                        Click="CloseBtn_Click"
                        Width="18" Height="18" FontSize="10" Padding="0"
                        Background="Transparent"
                        Foreground="{DynamicResource BrushTextMuted}"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="{l:T common.close}"
                        VerticalAlignment="Center" Margin="4,0,0,0"/>
            </Grid>
            <!-- 底部：action 按钮组（精简模式下隐藏） -->
            <StackPanel x:Name="actionsPanel" DockPanel.Dock="Bottom" Orientation="Horizontal"
                        Margin="0,6,0,0">
                <Button x:Name="askAiBtn" Click="AskAiBtn_Click"
                        Content="{l:T nativePanel.askAi}"
                        FontSize="{DynamicResource FontSizeTiny}"
                        Padding="10,3" Cursor="Hand"
                        Background="{DynamicResource BrushAccent}"
                        Foreground="White" BorderThickness="0"/>
            </StackPanel>
            <!-- 内容区：完整模式滚动展示（隐藏滚动条，仅滚轮滚动），精简模式由代码后置限制为 2 行高度 -->
            <ScrollViewer x:Name="contentScroll" Margin="0,4,0,0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="120"
                          PreviewMouseWheel="ContentScroll_PreviewMouseWheel">
                <emoji:TextBlock x:Name="contentText"
                                 Foreground="{DynamicResource BrushTextMain}"
                                 FontSize="{DynamicResource FontSizeSmall}"
                                 TextWrapping="Wrap"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
