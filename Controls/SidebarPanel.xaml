<UserControl x:Class="SideDesk.Controls.SidebarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SideDesk.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="205">
    <Grid>
        <!-- WebView2 模式面板 -->
        <local:WebViewModePanel x:Name="webViewPanel" Visibility="Visible" />
        
        <!-- 本地 UI 模式面板 -->
        <local:NativeModePanel x:Name="nativePanel" Visibility="Collapsed" />
        

    </Grid>
</UserControl>
