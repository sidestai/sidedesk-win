<UserControl x:Class="SideDesk.Controls.NativeModePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SideDesk.Controls"
             xmlns:framework="clr-namespace:SideDesk.Framework"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="205">
    <UserControl.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem x:Name="editModeMenu" Header="编辑模式" IsCheckable="True" IsChecked="False" Click="ToggleEditMode_Click"/>
            <Separator />
            <MenuItem x:Name="addModuleMenu" Header="添加模块">
                <MenuItem Header="分组" Click="AddGroupPanel_Click"/>
                <Separator/>
                <MenuItem Header="快捷方式" Click="AddQuickGroupPanel_Click"/>
                <MenuItem Header="便签" Click="AddStickyNotesPanel_Click"/>
                <MenuItem Header="今日待办" Click="AddTodoPanel_Click"/>
                <MenuItem Header="剪贴板收藏" Click="AddClipboardPanel_Click"/>
                <MenuItem Header="系统信息" Click="AddSystemMonitorPanel_Click"/>
                <MenuItem Header="使用统计" Click="AddUsageStatsPanel_Click"/>
                <MenuItem Header="AI 对话" Click="AddAIChatPanel_Click"/>
                <MenuItem Header="文件区" Click="AddFileAreaPanel_Click"/>
                <MenuItem Header="数据看板" Click="AddDataDashboard_Click"/>
                <MenuItem x:Name="addDataBlockMenu" Header="添加数据块" SubmenuOpened="AddDataBlockMenu_SubmenuOpened">
                    <MenuItem Header="(加载中...)" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="计时器" Click="AddTimerPanel_Click"/>
                <MenuItem Header="信号灯" Click="AddSignalLightPanel_Click"/>
            </MenuItem>
            <Separator />
            <MenuItem Header="布局" x:Name="LayoutMenu">
                <MenuItem Header="左侧停靠" Click="Layout_Left_Click" />
                <MenuItem Header="右侧停靠" Click="Layout_Right_Click" />
                <MenuItem Header="双侧停靠" Click="Layout_Both_Click" />
            </MenuItem>
            <Separator />
            <MenuItem Header="工具" x:Name="ToolsMenu" SubmenuOpened="ToolsMenu_SubmenuOpened">
                <MenuItem Header="(加载中...)" />
            </MenuItem>
            <Separator />
            <MenuItem Header="显示设置" x:Name="DisplaySettingsMenu" SubmenuOpened="DisplaySettingsMenu_SubmenuOpened">
                <MenuItem Header="(加载中...)" />
            </MenuItem>
            <Separator />
            <MenuItem Header="外观">
                <MenuItem x:Name="hideModuleFrameMenu" Header="隐藏模块外框" IsCheckable="True" Click="ToggleHideModuleFrame_Click"/>
            </MenuItem>
            <Separator />
            <MenuItem Header="使用统计" Click="ContextMenu_UsageStatsClick" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <DockPanel x:Name="nativeContent" LastChildFill="True">
        
        <!-- 底部工具栏（工具按钮区域） -->
        <Border x:Name="toolsBar" DockPanel.Dock="Bottom" Margin="5,2" Padding="5,3" CornerRadius="3"
                Background="{Binding GroupBGColor, Source={x:Static framework:AppSettings.Instance}, Converter={StaticResource StringToSolidColorBrushConverter}}"
                Visibility="Collapsed">
            <StackPanel x:Name="toolsBarContent" Orientation="Vertical"/>
        </Border>
        
        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Margin="5,2" Padding="5,3" CornerRadius="3"
                Background="{Binding GroupBGColor, Source={x:Static framework:AppSettings.Instance}, Converter={StaticResource StringToSolidColorBrushConverter}}">
            <StackPanel x:Name="statusBar" Orientation="Horizontal">
                <TextBlock x:Name="keyCountText" Text="⌨ 0" Margin="0,0,10,0" FontSize="11" Style="{StaticResource DataText}"/>
                <TextBlock x:Name="mouseDistText" Text="🖱 0m" FontSize="11" Style="{StaticResource DataText}"/>
            </StackPanel>
        </Border>
        
        <!-- 动态内容区 -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Style="{StaticResource ContentView}">
            <StackPanel x:Name="dynamicContent" Margin="0,10,0,0"/>
        </ScrollViewer>
        
    </DockPanel>
</UserControl>
