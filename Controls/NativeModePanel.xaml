<UserControl x:Class="SideDesk.Controls.NativeModePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SideDesk.Controls"
             xmlns:l="clr-namespace:SideDesk.Framework"
             xmlns:framework="clr-namespace:SideDesk.Framework"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="205">
    <UserControl.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem x:Name="editModeMenu" Header="{l:T nativePanel.editMode}" IsCheckable="True" IsChecked="False" Click="ToggleEditMode_Click"/>
            <Separator />
            <MenuItem x:Name="addModuleMenu" Header="{l:T common.addModule}">
                <MenuItem Header="{l:T common.group}" Click="AddGroupPanel_Click"/>
                <Separator/>
                <MenuItem Header="{l:T common.shortcut}" Click="AddQuickGroupPanel_Click"/>
                <MenuItem Header="{l:T common.stickyNotes}" Click="AddStickyNotesPanel_Click"/>
                <MenuItem Header="{l:T common.todayTodos}" Click="AddTodoPanel_Click"/>
                <MenuItem Header="{l:T common.clipboardFavorites}" Click="AddClipboardPanel_Click"/>
                <MenuItem Header="{l:T common.systemInfo}" Click="AddSystemMonitorPanel_Click"/>
                <MenuItem Header="{l:T common.usageStatistics}" Click="AddUsageStatsPanel_Click"/>
                <MenuItem Header="{l:T common.screenTime}" Click="AddScreenTimePanel_Click"/>
                <MenuItem Header="{l:T common.aiChat}" Click="AddAIChatPanel_Click"/>
                <MenuItem Header="{l:T common.fileArea}" Click="AddFileAreaPanel_Click"/>
                <MenuItem Header="{l:T common.dataDashboard}" Click="AddDataDashboard_Click"/>
                <MenuItem Header="{l:T common.timer}" Click="AddTimerPanel_Click"/>
                <MenuItem Header="{l:T common.countdown}" Click="AddCountdownPanel_Click"/>
                <MenuItem Header="{l:T common.pomodoroAlarm}" Click="AddPomodoroPanel_Click"/>
                <MenuItem Header="{l:T common.signalLight}" Click="AddSignalLightPanel_Click"/>
                <MenuItem Header="{l:T common.imageCarousel}" Click="AddImageCarouselPanel_Click"/>
                <MenuItem Header="{l:T common.dailyActivity}" Click="AddDailyActivityPanel_Click"/>
                <MenuItem Header="{l:T common.calendar}" Click="AddCalendarPanel_Click"/>
                <MenuItem Header="{l:T common.digitalEmployees}" Click="AddDigitalEmployeePanel_Click"/>
                <MenuItem Header="{l:T common.friends}" Click="AddFriendPanel_Click"/>
                <Separator/>
                <MenuItem x:Name="addDataBlockMenu" Header="{l:T nativePanel.addDataBlock}" SubmenuOpened="AddDataBlockMenu_SubmenuOpened">
                    <MenuItem Header="{l:T nativePanel.loading}" IsEnabled="False"/>
                </MenuItem>
                <MenuItem x:Name="addPluginMenu" Header="{l:T common.plugins}" SubmenuOpened="AddPluginMenu_SubmenuOpened">
                    <MenuItem Header="{l:T nativePanel.loading}" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="addTeamLibraryMenu" Header="{l:T nativePanel.addFromTeamComponent}" Click="AddFromTeamLibrary_Click"/>
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:T common.tools}" x:Name="ToolsMenu" SubmenuOpened="ToolsMenu_SubmenuOpened">
                <MenuItem Header="{l:T nativePanel.loading}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:T nativePanel.displaySettings}" x:Name="DisplaySettingsMenu" SubmenuOpened="DisplaySettingsMenu_SubmenuOpened">
                <MenuItem Header="{l:T nativePanel.loading}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:T common.appearance}">
                <MenuItem x:Name="hideModuleFrameMenu" Header="{l:T common.hideModuleFrame}" IsCheckable="True" Click="ToggleHideModuleFrame_Click"/>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>
    <DockPanel x:Name="nativeContent" LastChildFill="True">
        
        <!-- 底部工具栏（工具按钮区域，按钮居中对齐） -->
        <Border x:Name="toolsBar" DockPanel.Dock="Bottom" Margin="2,2" Padding="2,3" CornerRadius="3"
                Background="{Binding GroupBGColor, Source={x:Static framework:AppSettings.Instance}, Converter={StaticResource StringToSolidColorBrushConverter}}"
                Visibility="Collapsed">
            <StackPanel x:Name="toolsBarContent" Orientation="Vertical" HorizontalAlignment="Stretch"/>
        </Border>
        
        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Margin="5,2" Padding="5,3" CornerRadius="3"
                Background="{Binding GroupBGColor, Source={x:Static framework:AppSettings.Instance}, Converter={StaticResource StringToSolidColorBrushConverter}}">
            <StackPanel x:Name="statusBar" Orientation="Horizontal">
                <TextBlock x:Name="keyCountText" Text="⌨ 0" Margin="0,0,10,0" FontSize="11" Style="{StaticResource DataText}"/>
                <TextBlock x:Name="mouseDistText" Text="🖱 0m" FontSize="11" Style="{StaticResource DataText}"/>
            </StackPanel>
        </Border>
        
        <!-- 置顶区：置顶模块固定显示在滚动区上方，压缩下方 ScrollViewer 的可用高度 -->
        <Border x:Name="pinnedArea" DockPanel.Dock="Top" Visibility="Collapsed"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                Margin="2,0,2,0" Padding="0">
            <Grid>
                <StackPanel x:Name="pinnedContent" Margin="0,0,0,-4"/>
                <!-- 置顶区拖拽调序指示器（常驻叠加层） -->
                <Border x:Name="pinnedDropIndicator" Height="3" Background="DodgerBlue"
                        VerticalAlignment="Top" HorizontalAlignment="Stretch"
                        CornerRadius="1.5" IsHitTestVisible="False"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 动态内容区 -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Style="{StaticResource ContentView}">
            <Grid>
                <StackPanel x:Name="dynamicContent" Margin="0,4,0,0"/>
                <!-- 拖拽调序指示器：常驻叠加层，不参与布局，拖拽时仅切换可见性并定位，避免布局抖动 -->
                <Border x:Name="panelDropIndicator" Height="3" Background="DodgerBlue"
                        VerticalAlignment="Top" HorizontalAlignment="Stretch"
                        CornerRadius="1.5" IsHitTestVisible="False"
                        Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>
        
    </DockPanel>
</UserControl>
