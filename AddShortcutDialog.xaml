<Window x:Class="SideDesk.AddShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideDesk.Framework"
        xmlns:controls="clr-namespace:SideDesk.Controls"
        Title="{l:T settings.addShortcutItem}" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BrushDialogBG}" Foreground="{DynamicResource BrushTextMain}">
    <DockPanel Margin="20">
        <!-- 顶部切换按钮 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:T shortcut.webMarket}" Click="OpenWebMarket_Click"
                        Padding="10,4" Margin="0,0,8,0"
                        FontSize="{DynamicResource FontSizeSmall}"
                        Style="{StaticResource GhostButtonStyle}"/>
                <Button x:Name="toggleBatchBtn" Content="{l:T shortcut.batchMode}" Click="ToggleBatch_Click"
                        Padding="10,4"
                        FontSize="{DynamicResource FontSizeSmall}"
                        Style="{StaticResource GhostButtonStyle}"/>
            </StackPanel>
            <TextBlock Text="{l:T settings.addShortcutItem}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}"
                       Foreground="{DynamicResource BrushTextMain}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:T common.ok}" Width="75" Margin="0,0,10,0" Click="Ok_Click"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="{l:T common.cancel}" Width="75" Click="Cancel_Click"
                    Style="{StaticResource StandardButtonStyle}"/>
        </StackPanel>

        <!-- 内容区（单个/批量互斥显示） -->
        <Grid>
            <!-- 单个模式 -->
            <StackPanel x:Name="singlePanel">
                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="{l:T common.nameLabel}" Width="60" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                    <controls:EmojiTextBox x:Name="nameBox"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="{l:T shortcut.url}" Width="60" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                    <TextBox x:Name="urlBox" Text="https://" Style="{StaticResource GlobalTextBoxStyle}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="{l:T common.iconLabel}" Width="60" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                    <ContentControl x:Name="iconPreview" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox x:Name="iconBox" Style="{StaticResource GlobalTextBoxStyle}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox x:Name="appModeCheck" Style="{StaticResource RaycastSwitchStyle}" IsChecked="True"/>
                    <TextBlock Text="{l:T shortcut.appModeNoAddress}" FontSize="{DynamicResource FontSizeNormal}"
                               Foreground="{DynamicResource BrushTextSec}" 
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <!-- 浏览器选择 -->
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="{l:T common.browserLabel}" Width="60" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                    <ComboBox x:Name="browserCombo" 
                              Style="{StaticResource GlobalComboBoxStyle}"
                              SelectionChanged="BrowserCombo_Changed"/>
                </DockPanel>
                <!-- UserData 选择（浏览器选中后才显示） -->
                <DockPanel x:Name="profilePanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Left" Text="Profile：" Width="60" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource BrushTextMain}"/>
                    <ComboBox x:Name="profileCombo"
                              Style="{StaticResource GlobalComboBoxStyle}"/>
                </DockPanel>

                <!-- 背景颜色选择 -->
                <TextBlock Text="{l:T shortcut.buttonColorLabel}" Margin="0,14,0,8"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource BrushTextMain}"/>
                <WrapPanel x:Name="colorPickerPanel" Margin="0,0,0,4"/>
            </StackPanel>

            <!-- 批量模式 -->
            <Grid x:Name="batchPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 表头 -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{l:T common.icon}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource BrushTextSec}"/>
                    <TextBlock Grid.Column="1" Text="{l:T common.name}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource BrushTextSec}" Margin="5,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{l:T shortcut.urlPath}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource BrushTextSec}" Margin="5,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="App" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource BrushTextSec}" HorizontalAlignment="Center"/>
                </Grid>
                <!-- 行列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                    <StackPanel x:Name="batchRows"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
